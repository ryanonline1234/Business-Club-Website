---
/**
 * DashboardLayout — the shell for every approved-member page.
 * Renders: topbar (brand mark + desktop nav rail + whoami/role badge +
 * sign-out), the .page main container around the slot, and the fixed
 * phone thumb bar. Theme plumbing is color-scheme: light dark plus the
 * light-dark() variable pairs in global.css — no toggle, the OS decides.
 *
 * Fonts are self-hosted: the @fontsource imports below are bundled by
 * Astro into local woff2 files (no external requests at runtime).
 */
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/libre-baskerville/latin-400.css';
import '@fontsource/libre-baskerville/latin-600.css';
import '@fontsource/libre-baskerville/latin-700.css';
import TopRail from '../components/TopRail.astro';
import ThumbBar from '../components/ThumbBar.astro';

interface Props {
  title: string;
  subtitle?: string;
  user: {
    name: string | null;
    /** EFFECTIVE role — reads 'member' while an officer previews, which is
        exactly what the badge should say. */
    role: string;
    email: string;
    /** The REAL officer-ness, never downgraded by the preview. Both preview
        controls key off this and never off `isOfficer`: while previewing, the
        session reads as a member, so an `isOfficer` check would hide the only
        way back to officer view. */
    actualIsOfficer: boolean;
    viewingAsStudent: boolean;
  };
}

/* Default subtitle = the current school term in America/Los_Angeles.
   Aug–Dec → Fall, Jan–May → Spring, Jun–Jul → Summer. Never bucket on
   the server's UTC date. */
const parts = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/Los_Angeles',
  year: 'numeric',
  month: 'numeric',
}).formatToParts(new Date());
const month = Number(parts.find((p) => p.type === 'month')?.value ?? '1');
const year = parts.find((p) => p.type === 'year')?.value ?? '';
const term = month >= 8 ? 'Fall' : month <= 5 ? 'Spring' : 'Summer';

const { title, subtitle = `${term} ${year}`.trim(), user } = Astro.props;

const roleLabel =
  user.role === 'admin' ? 'Admin' : user.role === 'treasurer' ? 'Treasurer' : 'Member';
const displayName = user.name?.trim() || user.email;
const initials =
  (user.name ?? '')
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0]!.toUpperCase())
    .slice(0, 2)
    .join('') || user.email.slice(0, 2).toUpperCase();

const currentPath = Astro.url.pathname;

/* Officer preview. Both flags come from the real profiles role, so the exit
   banner survives the downgrade that hides everything else officer-shaped. */
const previewing = user.viewingAsStudent;
const canEnterPreview = user.actualIsOfficer && !previewing;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <title>{title} — Mitty Business Club</title>
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <!-- The club monogram, defined once; reuse anywhere with
       <svg viewBox="0 0 40 40"><use href="#monogram"/></svg> -->
  <svg width="0" height="0" class="svgdefs" aria-hidden="true" focusable="false">
    <defs>
      <g id="monogram" fill="none">
        <circle cx="20" cy="20" r="18.25" stroke="#8E7B48" stroke-width="1.3"/>
        <path d="M11 27.4h18M11 27.4V14.6l4.6 5.2L20 12l4.4 7.8 4.6-5.2v12.8" stroke="#8E7B48" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="M20 6.4v3.4M18.4 8.1h3.2" stroke="#8E7B48" stroke-width="1.3" stroke-linecap="round"/>
      </g>
    </defs>
  </svg>

  {previewing && (
    <div class="viewas">
      <div class="viewas__inner">
        <span class="viewas__tag">Viewing as a student</span>
        <span class="viewas__note">Officer controls are hidden.</span>
        {/* A REAL FORM, NOT A SCRIPTED BUTTON — deliberately, and unlike the
            "enter" control below. The cookie this clears is HttpOnly, so no
            page script can clear it as a fallback; if this depended on the
            bundled module and that chunk failed to load, the officer would be
            held in student view with nothing on the page able to get them out.
            A form submit works with JavaScript dead, exactly like Sign out.
            No data-preview-mode here: that attribute is the script's hook, and
            leaving it on would fire the fetch AND submit the form. */}
        <form method="post" action="/api/preview" class="viewas__exitform">
          <input type="hidden" name="mode" value="officer" />
          <button type="submit" class="viewas__exit">Back to officer view</button>
        </form>
      </div>
    </div>
  )}

  <header class="topbar">
    <div class:list={['topbar__inner', canEnterPreview && 'topbar__inner--viewas']}>
      {/* The brand mark is the portal's one route to the public /about page —
          "Home" already lives in the nav, so the logo is free to be the front
          door. Keep this href /about; without it /about is reachable only by
          typing the URL. */}
      <a class="mark" href="/about" title="About the club — our public page">
        <svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true"><use href="#monogram"/></svg>
        <span class="mark__word">Mitty Business Club<span>{subtitle}</span></span>
      </a>
      <TopRail currentPath={currentPath} />
      {canEnterPreview && (
        <button type="button" class="viewas-enter" data-preview-mode="student">
          View as student
        </button>
      )}
      <div class="whoami">
        <span class="avatar" aria-hidden="true">{initials}</span>
        <span class="whoami__meta">
          <span class="whoami__name">{displayName}</span>
          <span class="whoami__role">{roleLabel}</span>
        </span>
        <form method="post" action="/api/auth/signout" class="signout">
          <button type="submit" class="signout__btn">Sign out</button>
        </form>
      </div>
    </div>
  </header>

  <main class="page">
    <slot />
  </main>

  <ThumbBar currentPath={currentPath} />

  <script>
    /* The "View as student" (enter) control only — the exit is a plain form and
       must stay script-free, since the cookie it clears is HttpOnly and a dead
       script would otherwise trap the officer in student view.

       No HTML is built from data here: the script toggles `disabled`, writes
       textContent into the button it owns, and reloads so the SERVER re-renders
       every page under the new effective role. A no-op when the button is
       absent, i.e. for everyone who is not an officer. */
    document
      .querySelectorAll<HTMLButtonElement>('button[data-preview-mode="student"]')
      .forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            const res = await fetch('/api/preview', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ mode: 'student' }),
            });
            if (res.ok) {
              location.reload();
              return;
            }
            /* 401 = the session expired while this page sat open; 403 = the
               role changed under us. Retrying can only fail again, so reload
               and let the guards route them (to /login, or to a page whose
               chrome now matches reality) instead of leaving a dead button. */
            if (res.status === 401 || res.status === 403) {
              location.reload();
              return;
            }
          } catch {
            /* network error — fall through to the retry label */
          }
          btn.disabled = false;
          btn.textContent = 'Try again';
        });
      });
  </script>
</body>
</html>
