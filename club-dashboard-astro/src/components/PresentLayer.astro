---
/**
 * PresentLayer — the projected check-in surface: a full-bleed QR code that
 * re-fetches itself before its 15-minute token expires, with a live tally of
 * how many people have checked in. Officers only — the page renders it only
 * when the meeting can be presented (lib/event-time's check-in window).
 * Moved here from /calendar (retired 2026-10-26); used by /meetings/[id].
 *
 * The page supplies the opener: a button with id="present-open" carrying
 * data-event-id and data-event-title. Optional id="facts-checkins" on the
 * page's own check-in count is kept in step with the tally. Arriving with
 * ?present=1 (the home page's "Present check-in code") opens it at once.
 *
 * Feeds: GET /api/events/[id]/qr (the code) and GET /api/events/[id]/checkins
 * (a NUMBER, never names). White in BOTH themes — scanners need the contrast.
 */
interface Props {
  /** Server-rendered starting count; the poll takes over once open. */
  checkinCount: number;
}
const { checkinCount } = Astro.props;
---
<!-- Present mode: full-bleed projected surface. White in BOTH themes —
     scanners need the contrast. No student names ever appear here. -->
<div
  id="present-layer"
  role="dialog"
  aria-modal="true"
  aria-label="Projected check-in code"
  style="position:fixed; inset:0; z-index:60; background:var(--paper-3); display:none; place-items:center; padding:clamp(8px,2vw,24px);"
>
  <div class="present" style="width:100%; max-width:calc((100vh - 64px) * 16 / 9); max-width:calc((100dvh - 64px) * 16 / 9);">
    <div class="present__top">
      <p class="present__name" id="present-name"></p>
      <span class="present__live"><i></i>Live</span>
    </div>
    <div class="present__stage">
      <img id="present-qr" alt="Check-in QR code" />
      {/* Live tally — a NUMBER, never names (see the comment on this
          layer). Beside the QR, in the plate's spare width, so it costs the
          code none of its size. Seeded server-side, then polled while open. */}
      <span class="present__tally">
        <b class="present__tallynum" id="present-tally" data-count={checkinCount}>{checkinCount}</b>
        <span class="present__tallycap">checked in</span>
      </span>
    </div>
    <div class="present__foot">
      <div class="present__say">
        <span class="present__saylabel">Scan to check in</span>
        <span id="present-status" class="small" style="display:block; margin-top:4px; color:#6B5A2C;"></span>
      </div>
      <div class="present__meta">
        <span class="present__count" id="present-count"></span>
        <button
          type="button"
          id="present-exit"
          class="present__esc"
          style="background:none; border:0; cursor:pointer; min-height:48px; min-width:48px; padding:6px 0 0; text-align:right;"
        >Esc or tap here to exit</button>
      </div>
    </div>
  </div>
</div>

<script>
  /* Client JS is wiring only — no data is ever rendered into DOM HTML here.
     textContent + attribute assignment throughout. */

  /* ── Present mode (officers) ──────────────────────────────────────────── */
  // Strip ?present=1 unconditionally (even when Present isn't offered on this
  // render), so a later location.reload() can never reopen the layer.
  const presentParams = new URLSearchParams(location.search);
  const arrivedToPresent = presentParams.get('present') === '1';
  if (arrivedToPresent) {
    presentParams.delete('present');
    const qs = presentParams.toString();
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + location.hash);
  }
  const openBtn = document.getElementById('present-open') as HTMLButtonElement | null;
  const layer = document.getElementById('present-layer');
  if (openBtn && layer) {
    const nameEl = document.getElementById('present-name') as HTMLElement;
    const qrImg = document.getElementById('present-qr') as HTMLImageElement;
    const countEl = document.getElementById('present-count') as HTMLElement;
    const statusEl = document.getElementById('present-status') as HTMLElement;
    const exitBtn = document.getElementById('present-exit') as HTMLButtonElement;
    const tallyEl = document.getElementById('present-tally') as HTMLElement;
    const factsCountEl = document.getElementById('facts-checkins');

    const eventId = openBtn.dataset.eventId ?? '';
    const eventTitle = openBtn.dataset.eventTitle ?? '';

    /** Re-fetch this long before the token actually expires (15 min TTL →
     *  a fresh code roughly every 12 minutes). */
    const REFRESH_MARGIN_S = 180;

    let isOpen = false;
    let refreshAtMs = 0;
    let tickTimer = 0;
    let fetchTimer = 0;

    /* Generation counters, one per loop. Each loop captures its generation
       and only reschedules while it is still current, so a request that was
       in flight when Present closed (or the tab came back) can never start a
       second, parallel loop. Bumped on open, on close, and to stop a loop. */
    let codeGen = 0;
    let countGen = 0;

    /* ── Live tally ─────────────────────────────────────────────────────────
       Polls a count-only endpoint. Polling, not Supabase Realtime: realtime
       would need supabase-js in the browser plus an end-user token path, all
       to move one integer; one projector asking every 3s is nothing. The
       number is written with textContent only.
       Failures are never terminal: the guard answers 401/403 on a transient
       Supabase blip (and while "view as student" is on in another tab), so
       the loop keeps asking, slower, and the number dims after a few misses
       so a frozen count is visible rather than silent. */
    const COUNT_POLL_MS = 3_000;
    const COUNT_POLL_SLOW_MS = 15_000; // hidden tab, or after a failed poll
    const STALE_AFTER_FAILS = 3;
    let shownCount = Number(tallyEl.dataset.count ?? '0') || 0;
    let countTimer = 0;
    let countFails = 0;
    let countStopped = false; // check-in closed: the count can't change

    const setCount = (n: number) => {
      if (n === shownCount) return;
      const rose = n > shownCount;
      shownCount = n;
      tallyEl.textContent = String(n);
      if (factsCountEl) factsCountEl.textContent = String(n);
      if (rose) {
        // Restart the bump even if the last one is mid-flight.
        tallyEl.classList.remove('is-bump');
        void tallyEl.offsetWidth;
        tallyEl.classList.add('is-bump');
      }
    };

    const pollCount = async (gen: number) => {
      if (!isOpen || gen !== countGen) return;
      if (!document.hidden) {
        let ok = false;
        try {
          const res = await fetch(`/api/events/${encodeURIComponent(eventId)}/checkins`, {
            headers: { accept: 'application/json' },
            cache: 'no-store',
          });
          if (res.ok) {
            const body = await res.json();
            if (typeof body.count === 'number') {
              setCount(body.count);
              ok = true;
            }
          }
        } catch {
          /* network blip — keep the last number and try again */
        }
        countFails = ok ? 0 : countFails + 1;
        tallyEl.classList.toggle('is-stale', countFails >= STALE_AFTER_FAILS);
      }
      if (isOpen && gen === countGen) {
        countTimer = window.setTimeout(
          () => void pollCount(gen),
          document.hidden || countFails > 0 ? COUNT_POLL_SLOW_MS : COUNT_POLL_MS
        );
      }
    };
    const stopCount = () => {
      countStopped = true;
      countGen++;
      window.clearTimeout(countTimer);
    };

    const fmtCountdown = (ms: number) => {
      const s = Math.max(0, Math.ceil(ms / 1000));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };
    const tick = () => {
      if (!isOpen || refreshAtMs === 0) return;
      countEl.textContent = `Refreshes in ${fmtCountdown(refreshAtMs - Date.now())}`;
    };

    const fetchCode = async (gen: number) => {
      if (!isOpen || gen !== codeGen) return;
      const again = (ms: number) => {
        if (isOpen && gen === codeGen) fetchTimer = window.setTimeout(() => void fetchCode(gen), ms);
      };
      try {
        const res = await fetch(`/api/events/${encodeURIComponent(eventId)}/qr`, {
          headers: { accept: 'application/json' },
        });
        if (!isOpen || gen !== codeGen) return;
        if (!res.ok) {
          let msg = 'Could not fetch a check-in code.';
          try {
            const body = await res.json();
            if (body && typeof body.error === 'string') msg = body.error;
          } catch {
            /* keep fallback */
          }
          statusEl.textContent = msg;
          countEl.textContent = '';
          refreshAtMs = 0;
          // 404/409 = this event can no longer take check-ins (gone, over, or
          // cancelled): stop both loops — the count can't change any more.
          // 400 = unusable id: stop. Everything else (401/403 on a transient
          // auth blip, 5xx, …) retries shortly.
          if (res.status === 404 || res.status === 409) {
            stopCount();
            return;
          }
          if (res.status === 400) return;
          again(30_000);
          return;
        }
        const body = await res.json();
        if (typeof body.qr === 'string') qrImg.src = body.qr;
        statusEl.textContent = '';
        const expiresInS = typeof body.expires_in === 'number' ? body.expires_in : 900;
        const waitS = Math.max(expiresInS - REFRESH_MARGIN_S, 30);
        refreshAtMs = Date.now() + waitS * 1000;
        again(waitS * 1000);
        tick();
      } catch {
        if (!isOpen || gen !== codeGen) return;
        statusEl.textContent = 'Network error — retrying shortly.';
        countEl.textContent = '';
        refreshAtMs = 0;
        again(30_000);
      }
    };

    const openLayer = () => {
      isOpen = true;
      nameEl.textContent = eventTitle;
      statusEl.textContent = 'Fetching a fresh code…';
      countEl.textContent = '';
      countFails = 0;
      countStopped = false;
      tallyEl.classList.remove('is-stale');
      layer.style.display = 'grid';
      document.body.style.overflow = 'hidden';
      exitBtn.focus();
      void fetchCode(++codeGen);
      void pollCount(++countGen);
      tickTimer = window.setInterval(tick, 1000);
    };
    const closeLayer = () => {
      isOpen = false;
      codeGen++;
      countGen++;
      layer.style.display = 'none';
      document.body.style.overflow = '';
      window.clearInterval(tickTimer);
      window.clearTimeout(fetchTimer);
      window.clearTimeout(countTimer);
      refreshAtMs = 0;
      qrImg.removeAttribute('src');
      openBtn.focus();
    };

    // Back from a hidden tab: refresh the count now rather than after the
    // slow interval, so the room isn't looking at a stale number. A fresh
    // generation means a poll still in flight can't become a second loop.
    // A loop stopped because check-in closed stays stopped.
    document.addEventListener('visibilitychange', () => {
      if (isOpen && !document.hidden && !countStopped) {
        window.clearTimeout(countTimer);
        void pollCount(++countGen);
      }
    });

    openBtn.addEventListener('click', openLayer);

    // Arrived from the home page's "Present check-in code" (?present=1, already
    // stripped above): open straight into Present mode.
    if (arrivedToPresent) openLayer();
    exitBtn.addEventListener('click', closeLayer);
    document.addEventListener('keydown', (e) => {
      if (isOpen && e.key === 'Escape') closeLayer();
    });
  }
</script>
