---
/**
 * TopRail — the desktop navigation rail that lives inside the topbar.
 * Rendered by DashboardLayout; global.css removes it entirely under 700px
 * (`.topbar .nav{ display:none }`) where ThumbBar takes over.
 */
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const items = [
  { href: '/', label: 'Home' },
  { href: '/calendar', label: 'Calendar' },
  { href: '/attendance', label: 'Attendance' },
  { href: '/members', label: 'Members' },
  { href: '/announcements', label: 'Announcements' },
];

// /meetings belongs to the Calendar tab (no sixth nav item — the officer
// top bar has no room for one at iPad widths).
const SECTION_ALIASES: Record<string, string[]> = { '/calendar': ['/meetings'] };
const isActive = (href: string) =>
  href === '/'
    ? currentPath === '/'
    : [href, ...(SECTION_ALIASES[href] ?? [])].some((p) => currentPath === p || currentPath.startsWith(p + '/'));
---
<nav class="nav" aria-label="Portal">
  {items.map((item) => (
    <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>
