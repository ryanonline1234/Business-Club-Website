---
/**
 * /calendar — the events view.
 *
 * Month grid ≥980px with the agenda's per-event list under it (below 980px
 * the agenda is the whole view; both are always rendered).
 * All event data is rendered SERVER-SIDE in this template — client JS only
 * submits forms, fetches the QR code, polls the check-in COUNT while Present
 * mode is open (written via textContent into the tally and the "Checked in"
 * fact), and reloads. Day bucketing and "today"
 * use Pacific-local date keys, never the server's UTC date.
 *
 * Cancelled events never render on this page: they are filtered out right
 * after the query (month grid, agenda, pips, selection — a ?event= id
 * pointing at one behaves exactly like an unknown id). The rows stay in the
 * database; un-cancelling is a table-editor operation.
 *
 * Officer flows: New event (disclosure composer → POST /api/events/create),
 * Cancel event (inline confirm → DELETE /api/events/[id]/delete), Present
 * mode (full-bleed projected surface fed by GET /api/events/[id]/qr, silently
 * re-fetched before the 15-minute token expires, with a live tally polled from
 * GET /api/events/[id]/checkins — a number, never names), the attendance PDF
 * (GET /api/events/[id]/attendance.pdf, once check-in has opened).
 *
 * Editing an event's details, its slides link, its recap and its photos all
 * live on the meeting's own page, /meetings/[id] — one place per edit control.
 * The event detail here links to it.
 */
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { requireApproved } from '../lib/auth';
import { supabaseAdmin } from '../lib/supabase';
import { CHECKIN_OPENS_BEFORE_MS, checkinWindow, explicitEndMs, isHappeningNow } from '../lib/event-time';

const user = await requireApproved(Astro.request, Astro.response.headers, Astro.redirect);

interface EventRow {
  id: string;
  title: string;
  description: string | null;
  start_time: string;
  end_time: string | null;
  location: string | null;
  category: string | null;
  capacity: number | null;
  status: string;
  created_by: string | null;
}

const { data: eventsData, error: eventsError } = await supabaseAdmin
  .from('events')
  .select('id, title, description, start_time, end_time, location, category, capacity, status, created_by')
  .order('start_time', { ascending: true });

if (eventsError) {
  console.error('[pages/calendar] events query failed', {
    message: eventsError.message,
    code: eventsError.code,
  });
}
/* Soft-deleted rows are invisible here — every consumer below (byDay,
   monthEvents, cells, the selection chain) reads this filtered list, so a
   cancelled ?event= id falls through to the same state as an unknown id. */
const events: EventRow[] = ((eventsData ?? []) as EventRow[]).filter(
  (e) => e.status !== 'cancelled'
);

/* ── Pacific-local time helpers ─────────────────────────────────────────── */
const TZ = 'America/Los_Angeles';
const pacificDayKey = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: TZ });

const fmtDayLong = new Intl.DateTimeFormat('en-US', {
  timeZone: TZ,
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});
const fmtWeekday = new Intl.DateTimeFormat('en-US', { timeZone: TZ, weekday: 'short' });
const fmtDayNum = new Intl.DateTimeFormat('en-US', { timeZone: TZ, day: '2-digit' });
const fmtTime = (iso: string) =>
  new Date(iso).toLocaleTimeString('en-US', { timeZone: TZ, hour: 'numeric', minute: '2-digit' });

const nowMs = Date.now();

/* Start / end / check-in rules come from lib/event-time — the same module the
   check-in and QR endpoints use, so the Present button can never offer a code
   the endpoint would refuse. Meetings without an end_time end the day of. */
const startMsOf = (e: EventRow) => Date.parse(e.start_time);
/** The explicit end, or NaN when there is none (the meeting ends with its day). */
const endMsOf = (e: EventRow) => explicitEndMs(e.start_time, e.end_time) ?? Number.NaN;
const isNow = (e: EventRow) => e.status === 'active' && isHappeningNow(e.start_time, e.end_time, nowMs);
const checkinClosesAt = (e: EventRow) => checkinWindow(e.start_time, e.end_time)?.closesAt ?? Number.NaN;

/** "3:30 – 4:45 PM" — drop the first meridiem when both sides share it. */
function timeRange(e: EventRow): string {
  const start = fmtTime(e.start_time);
  const en = endMsOf(e);
  if (Number.isNaN(en)) return start;
  const end = fmtTime(e.end_time as string);
  const sm = start.match(/ (AM|PM)$/)?.[1];
  const em = end.match(/ (AM|PM)$/)?.[1];
  const startShown = sm && sm === em ? start.replace(/ (AM|PM)$/, '') : start;
  return `${startShown} – ${end}`;
}

const catLabel = (c: string | null) => {
  const t = (c ?? '').trim() || 'meeting';
  return t.charAt(0).toUpperCase() + t.slice(1);
};

/* ── Selected month + selected event (from query params) ────────────────── */
const todayKey = pacificDayKey(new Date());
const rawMonth = Astro.url.searchParams.get('month');
const eventParam = Astro.url.searchParams.get('event');

const selected: EventRow | null =
  (eventParam ? events.find((e) => e.id === eventParam) : undefined) ??
  // Most recently started live event: a no-end meeting stays "now" until
  // midnight, so with two today the later (actual) one should win.
  [...events].reverse().find(isNow) ??
  events.find((e) => e.status === 'active' && startMsOf(e) >= nowMs) ??
  [...events].reverse().find((e) => e.status === 'active') ??
  events[events.length - 1] ??
  null;

let monthStr: string | null = null;
if (rawMonth && /^\d{4}-\d{2}$/.test(rawMonth)) {
  const m = Number(rawMonth.slice(5));
  if (m >= 1 && m <= 12) monthStr = rawMonth;
}
if (!monthStr && eventParam && selected && !Number.isNaN(startMsOf(selected))) {
  monthStr = pacificDayKey(new Date(selected.start_time)).slice(0, 7);
}
if (!monthStr) monthStr = todayKey.slice(0, 7);

/* ── Month grid (weekday math on UTC dates — timezone-independent) ──────── */
const pad2 = (n: number) => String(n).padStart(2, '0');
const [gy, gm] = monthStr.split('-').map(Number);
const monthLabel = new Date(Date.UTC(gy, gm - 1, 1)).toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  year: 'numeric',
});
const daysInMonth = new Date(Date.UTC(gy, gm, 0)).getUTCDate();
const firstDow = new Date(Date.UTC(gy, gm - 1, 1)).getUTCDay();
const prevMonthDays = new Date(Date.UTC(gy, gm - 1, 0)).getUTCDate();
const prevMonthStr = gm === 1 ? `${gy - 1}-12` : `${gy}-${pad2(gm - 1)}`;
const nextMonthStr = gm === 12 ? `${gy + 1}-01` : `${gy}-${pad2(gm + 1)}`;
const shortMonthOf = (s: string) =>
  new Date(Date.UTC(Number(s.slice(0, 4)), Number(s.slice(5)) - 1, 1)).toLocaleDateString('en-US', {
    timeZone: 'UTC',
    month: 'short',
  });
const prevLabel = shortMonthOf(prevMonthStr);
const nextLabel = shortMonthOf(nextMonthStr);

const byDay = new Map<string, EventRow[]>();
for (const e of events) {
  const s = startMsOf(e);
  if (Number.isNaN(s)) continue;
  const key = pacificDayKey(new Date(s));
  const list = byDay.get(key);
  if (list) list.push(e);
  else byDay.set(key, [e]);
}

const monthEvents = events.filter(
  (e) => !Number.isNaN(startMsOf(e)) && pacificDayKey(new Date(e.start_time)).slice(0, 7) === monthStr
);
const monthCount = `${monthEvents.length} event${monthEvents.length === 1 ? '' : 's'}`;

type Cell =
  | { kind: 'muted'; n: number }
  | { kind: 'day'; n: number; key: string; events: EventRow[]; activeCount: number; isToday: boolean };
const cells: Cell[] = [];
for (let i = firstDow - 1; i >= 0; i--) cells.push({ kind: 'muted', n: prevMonthDays - i });
for (let d = 1; d <= daysInMonth; d++) {
  const key = `${monthStr}-${pad2(d)}`;
  const dayEvents = byDay.get(key) ?? [];
  cells.push({
    kind: 'day',
    n: d,
    key,
    events: dayEvents,
    activeCount: dayEvents.filter((e) => e.status === 'active').length,
    isToday: key === todayKey,
  });
}
const trailing = (7 - (cells.length % 7)) % 7;
for (let i = 1; i <= trailing; i++) cells.push({ kind: 'muted', n: i });

/* ── Selected-event extras: check-in count + creator name ───────────────── */
let checkinCount = 0;
let creatorName: string | null = null;
if (selected) {
  const { count, error: countError } = await supabaseAdmin
    .from('attendance')
    .select('id', { count: 'exact', head: true })
    .eq('event_id', selected.id);
  if (countError) {
    console.error('[pages/calendar] attendance count failed', { message: countError.message });
  }
  checkinCount = count ?? 0;

  if (selected.created_by) {
    const { data: creator } = await supabaseAdmin
      .from('profiles')
      .select('name')
      .eq('id', selected.created_by)
      .maybeSingle();
    creatorName = (creator?.name as string | null) ?? null;
  }
}

/* ── My own check-in for the selected event ───────────────────────────────
   Asked once the check-in window has opened (start − 30 min, the same rule
   POST /api/attendance/checkin enforces); before that there is nothing to
   report. Own row only. A failed read renders nothing rather than a false ✗. */
const checkinHasOpened =
  selected !== null && nowMs >= startMsOf(selected) - CHECKIN_OPENS_BEFORE_MS;
let myCheckin: { checkedIn: boolean; time: string | null } | null = null;
if (selected && checkinHasOpened) {
  const { data: mine, error: mineError } = await supabaseAdmin
    .from('attendance')
    .select('checked_in_at')
    .eq('event_id', selected.id)
    .eq('member_id', user.id)
    .maybeSingle();
  if (mineError) {
    console.error('[pages/calendar] own check-in lookup failed', { message: mineError.message });
  } else {
    myCheckin = mine
      ? { checkedIn: true, time: mine.checked_in_at ? fmtTime(mine.checked_in_at as string) : null }
      : { checkedIn: false, time: null };
  }
}

const selectedIsNow = selected ? isNow(selected) : false;

const selectedWhen = selected
  ? `${fmtDayLong.format(new Date(selected.start_time))} · ${timeRange(selected)}`
  : '';
const canPresent =
  user.isOfficer &&
  selected !== null &&
  selected.status === 'active' &&
  !Number.isNaN(checkinClosesAt(selected)) &&
  nowMs <= checkinClosesAt(selected);
---
<DashboardLayout title="Events" user={user}>
  <h1 class="sr">Events</h1>

  <div class="eventgrid">
    <div>
      <!-- Desktop month grid (auto-hidden ≤979px) -->
      <section class="month" aria-label={monthLabel}>
        <div class="month__head">
          <b>{monthLabel}</b>
          <span>{monthCount}</span>
        </div>
        <div class="month__grid">
          <span class="dow">S</span><span class="dow">M</span><span class="dow">T</span><span class="dow">W</span><span class="dow">T</span><span class="dow">F</span><span class="dow">S</span>
          {cells.map((c) =>
            c.kind === 'muted' ? (
              <span class="day muted">{c.n}</span>
            ) : c.events.length > 0 ? (
              <a
                class:list={['day', { today: c.isToday }]}
                href={`/calendar?month=${monthStr}&event=${c.events[0].id}`}
              >{c.n}{c.activeCount > 0 && <i class="pip"></i>}<span class="sr">
                {c.isToday ? 'Today, ' : ''}{c.events.length} event{c.events.length === 1 ? '' : 's'}
              </span></a>
            ) : (
              <span class:list={['day', { today: c.isToday }]}>{c.n}{c.isToday && <span class="sr">Today</span>}</span>
            )
          )}
        </div>
        <p class="monthnav">
          <a class="btn btn--ghost btn--sm" href={`/calendar?month=${prevMonthStr}`}>← {prevLabel}</a>
          <a class="btn btn--ghost btn--sm" href="/meetings" style="margin-inline:auto">All meetings</a>
          <a class="btn btn--ghost btn--sm" href={`/calendar?month=${nextMonthStr}`}>{nextLabel} →</a>
        </p>
      </section>

      <!-- Phone agenda list (auto-hidden ≥980px) -->
      <section class="agenda" aria-label={`${monthLabel} agenda`}>
        <div class="section-head">
          <h2>{monthLabel}</h2>
          <span class="spacer"></span>
          <span class="count">{monthCount}</span>
        </div>
        {monthEvents.length === 0 ? (
          <div class="state">
            <b>Nothing in {monthLabel}</b>
            <p>When an event lands on this month, it shows up here.</p>
          </div>
        ) : (
          <ul class="rowlist">
            {monthEvents.map((e) => {
              const live = isNow(e);
              const d = new Date(e.start_time);
              return (
                <li>
                  <a
                    class="rowlink"
                    href={`/calendar?month=${monthStr}&event=${e.id}`}
                    aria-current={selected && e.id === selected.id ? 'true' : undefined}
                  >
                    <span class="datestamp datestamp--sm" aria-hidden="true"><b>{fmtDayNum.format(d)}</b><i>{fmtWeekday.format(d)}</i></span>
                    <span class="rowlink__main">
                      <span class="rowlink__title">{e.title}</span>
                      <span class="rowlink__sub">
                        {live && <><span class="hl">Now</span>{' · '}</>}{fmtTime(e.start_time)}{e.location ? ` · ${e.location}` : ''}
                      </span>
                    </span>
                    <span class="chev" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
        <p class="monthnav">
          <a class="btn btn--ghost btn--sm" href={`/calendar?month=${prevMonthStr}`}>← {prevLabel}</a>
          <a class="btn btn--ghost btn--sm" href="/meetings" style="margin-inline:auto">All meetings</a>
          <a class="btn btn--ghost btn--sm" href={`/calendar?month=${nextMonthStr}`}>{nextLabel} →</a>
        </p>
      </section>

    </div>

    <div>
      {user.isOfficer && (
        <details class="composer">
          <summary>New event</summary>
          <form class="composer__form" id="event-form" novalidate>
            <div class="composer__head">
              <b>New event</b>
              <span class="flag">Officer only</span>
            </div>
            <label class="field">
              <span>Title</span>
              <input class="input" type="text" name="title" required maxlength="200" autocomplete="off" />
            </label>
            <div class="composer__duo">
              <label class="field">
                <span>Starts</span>
                <input class="input" type="datetime-local" name="start" required />
                <span class="field__hint">Pacific time.</span>
              </label>
              <label class="field">
                <span>Ends</span>
                <input class="input" type="time" name="end" />
                <span class="field__hint js-end-hint">Same day as the start. Leave it blank and the meeting ends at midnight.</span>
              </label>
            </div>
            <div class="composer__duo">
              <label class="field">
                <span>Location</span>
                <input class="input" type="text" name="location" maxlength="300" autocomplete="off" />
              </label>
              <label class="field">
                <span>Capacity</span>
                <input class="input" type="number" name="capacity" min="1" step="1" inputmode="numeric" />
                <span class="field__hint">Optional. Leave blank for no cap.</span>
              </label>
            </div>
            <div class="composer__duo">
              <label class="field">
                <span>Category</span>
                <select class="select" name="category">
                  <option value="meeting" selected>Meeting</option>
                  <option value="workshop">Workshop</option>
                  <option value="speaker">Speaker</option>
                  <option value="social">Social</option>
                  <option value="deadline">Deadline</option>
                </select>
              </label>
            </div>
            <label class="field">
              <span>Description</span>
              <textarea class="textarea" name="description" maxlength="5000"></textarea>
              <span class="field__hint">Optional. Plain text — members see it on the event page.</span>
            </label>
            <p id="event-form-error" class="small js-form-error" role="alert" style="color:var(--clay); display:none;"></p>
            <div class="composer__actions">
              <button class="btn" type="submit">Create event</button>
            </div>
          </form>
        </details>
      )}
      {selected === null ? (
        <div class="state state--rule">
          <b>Nothing on the calendar yet</b>
          <p>
            {user.isOfficer
              ? 'Use “New event” to put the first one on the books.'
              : 'When officers schedule an event, it lands here.'}
          </p>
        </div>
      ) : (
        <article class="event-detail">
          <p class="event-detail__cat">
            {selectedIsNow && <span class="tag tag--now">Happening now</span>}
            <span class="tag">{catLabel(selected.category)}</span>
          </p>
          <h2>{selected.title}</h2>
          {selected.description && <p class="event-detail__desc">{selected.description}</p>}

          <dl class="facts">
            <div><dt>When</dt><dd>{selectedWhen}</dd></div>
            <div><dt>Where</dt><dd>{selected.location ?? 'To be announced'}</dd></div>
            <div>
              <dt>Checked in</dt>
              <dd><span class="num" id="facts-checkins">{checkinCount}</span>{selected.capacity !== null && <> of <span class="num">{selected.capacity}</span></>}</dd>
            </div>
            <div><dt>Created by</dt><dd>{creatorName ?? '—'}</dd></div>
            {myCheckin && (
              <div>
                <dt>Your check-in</dt>
                <dd>
                  {myCheckin.checkedIn ? (
                    <span class="checkstate checkstate--in">
                      <span class="checkstate__mark" aria-hidden="true">✓</span>
                      Checked in{myCheckin.time ? ` · ${myCheckin.time}` : ''}
                    </span>
                  ) : (
                    <span class="checkstate">
                      <span class="checkstate__mark" aria-hidden="true">○</span>
                      Not checked in
                    </span>
                  )}
                </dd>
              </div>
            )}
          </dl>

          {user.isOfficer && selected.status === 'active' && (
            <div class="event-actions owned">
              <div class="event-actions__head"><span class="flag">Officer only</span></div>
              <div class="event-actions__row">
                {canPresent && (
                  <button class="btn" type="button" id="present-open" data-event-id={selected.id} data-event-title={selected.title}>
                    Present check-in code
                  </button>
                )}
                {checkinHasOpened && (
                  <a
                    class="btn btn--ghost"
                    href={`/api/events/${encodeURIComponent(selected.id)}/attendance.pdf`}
                    download
                  >Attendance PDF</a>
                )}
                <details class="confirm">
                  <summary class="btn btn--danger">Cancel event</summary>
                  <div class="confirm__row">
                    <span class="confirm__q">
                      Cancel this event?{checkinCount > 0 ? ` ${checkinCount} ${checkinCount === 1 ? 'person is' : 'people are'} already checked in.` : ''}
                    </span>
                    <button class="btn btn--sm btn--danger-go" type="button" id="cancel-event-go" data-event-id={selected.id}>Cancel it</button>
                    <button class="btn btn--sm btn--ghost" type="button" id="cancel-event-keep">Keep it</button>
                  </div>
                </details>
              </div>
              <p id="event-actions-error" class="small" role="alert" style="color:var(--clay); display:none; margin-top:10px;"></p>
            </div>
          )}

          {/* The meeting's own page is the one place its record is edited:
              details, slides link, recap and photos (docs/MEETINGS-ARCHIVE-SCOPE.md
              § "One place per edit control"). Everyone can open it. */}
          <p class="event-detail__more">
            <a class="btn btn--ghost" href={`/meetings/${encodeURIComponent(selected.id)}`}>
              {user.isOfficer ? 'Edit meeting — slides, recap & photos' : 'Meeting page — slides, recap & photos'}
            </a>
          </p>
        </article>
      )}
    </div>
  </div>

  <!-- Present mode: full-bleed projected surface. White in BOTH themes —
       scanners need the contrast. No student names ever appear here. -->
  {canPresent && selected && (
    <div
      id="present-layer"
      role="dialog"
      aria-modal="true"
      aria-label="Projected check-in code"
      style="position:fixed; inset:0; z-index:60; background:var(--paper-3); display:none; place-items:center; padding:clamp(8px,2vw,24px);"
    >
      <div class="present" style="width:100%; max-width:calc((100vh - 64px) * 16 / 9); max-width:calc((100dvh - 64px) * 16 / 9);">
        <div class="present__top">
          <p class="present__name" id="present-name"></p>
          <span class="present__live"><i></i>Live</span>
        </div>
        <div class="present__stage">
          <img id="present-qr" alt="Check-in QR code" />
          {/* Live tally — a NUMBER, never names (see the comment on this
              layer). Beside the QR, in the plate's spare width, so it costs the
              code none of its size. Seeded server-side, then polled while open. */}
          <span class="present__tally">
            <b class="present__tallynum" id="present-tally" data-count={checkinCount}>{checkinCount}</b>
            <span class="present__tallycap">checked in</span>
          </span>
        </div>
        <div class="present__foot">
          <div class="present__say">
            <span class="present__saylabel">Scan to check in</span>
            <span id="present-status" class="small" style="display:block; margin-top:4px; color:#6B5A2C;"></span>
          </div>
          <div class="present__meta">
            <span class="present__count" id="present-count"></span>
            <button
              type="button"
              id="present-exit"
              class="present__esc"
              style="background:none; border:0; cursor:pointer; min-height:48px; min-width:48px; padding:6px 0 0; text-align:right;"
            >Esc or tap here to exit</button>
          </div>
        </div>
      </div>
    </div>
  )}
</DashboardLayout>


<script>
  import { wireCreateForm } from '../scripts/event-form';

  /* Client JS is wiring only — no data is ever rendered into DOM HTML here.
     textContent + attribute assignment throughout. */

  /* ── New event (officers) — the shared logic is src/scripts/event-form.ts.
     Edit details lives on each meeting's page (/meetings/[id]). ──────────── */
  const form = document.getElementById('event-form') as HTMLFormElement | null;
  if (form) {
    // Arrived from /meetings → "Add a past meeting" (?new=1): open the composer,
    // and land on the new meeting's page once it's created.
    const newParams = new URLSearchParams(location.search);
    const arrivedToCreate = newParams.get('new') === '1';
    wireCreateForm(form, { landOnMeetingPage: arrivedToCreate });
    if (arrivedToCreate) {
      newParams.delete('new');
      const qs = newParams.toString();
      history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + location.hash);
      const composer = form.closest('details');
      if (composer) {
        composer.open = true;
        composer.scrollIntoView({ block: 'start' });
      }
    }
  }

  /* ── Cancel event (officers, inline confirm) ──────────────────────────── */
  const cancelGo = document.getElementById('cancel-event-go') as HTMLButtonElement | null;
  const cancelKeep = document.getElementById('cancel-event-keep');
  if (cancelKeep) {
    cancelKeep.addEventListener('click', () => {
      cancelKeep.closest('details')?.removeAttribute('open');
    });
  }
  if (cancelGo) {
    const actionsErr = document.getElementById('event-actions-error') as HTMLElement;
    cancelGo.addEventListener('click', async () => {
      const id = cancelGo.dataset.eventId;
      if (!id) return;
      cancelGo.disabled = true;
      actionsErr.style.display = 'none';
      try {
        const res = await fetch(`/api/events/${encodeURIComponent(id)}/delete`, { method: 'DELETE' });
        if (!res.ok) {
          let msg = 'Could not cancel the event.';
          try {
            const body = await res.json();
            if (body && typeof body.error === 'string') msg = body.error;
          } catch {
            /* keep fallback */
          }
          actionsErr.textContent = msg;
          actionsErr.style.display = 'block';
          cancelGo.disabled = false;
          return;
        }
        location.reload();
      } catch {
        actionsErr.textContent = 'Network error — check your connection and try again.';
        actionsErr.style.display = 'block';
        cancelGo.disabled = false;
      }
    });
  }

  /* ── Present mode (officers) ──────────────────────────────────────────── */
  // Strip ?present=1 unconditionally (even when Present isn't offered on this
  // render), so a later location.reload() can never reopen the layer.
  const presentParams = new URLSearchParams(location.search);
  const arrivedToPresent = presentParams.get('present') === '1';
  if (arrivedToPresent) {
    presentParams.delete('present');
    const qs = presentParams.toString();
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + location.hash);
  }
  const openBtn = document.getElementById('present-open') as HTMLButtonElement | null;
  const layer = document.getElementById('present-layer');
  if (openBtn && layer) {
    const nameEl = document.getElementById('present-name') as HTMLElement;
    const qrImg = document.getElementById('present-qr') as HTMLImageElement;
    const countEl = document.getElementById('present-count') as HTMLElement;
    const statusEl = document.getElementById('present-status') as HTMLElement;
    const exitBtn = document.getElementById('present-exit') as HTMLButtonElement;
    const tallyEl = document.getElementById('present-tally') as HTMLElement;
    const factsCountEl = document.getElementById('facts-checkins');

    const eventId = openBtn.dataset.eventId ?? '';
    const eventTitle = openBtn.dataset.eventTitle ?? '';

    /** Re-fetch this long before the token actually expires (15 min TTL →
     *  a fresh code roughly every 12 minutes). */
    const REFRESH_MARGIN_S = 180;

    let isOpen = false;
    let refreshAtMs = 0;
    let tickTimer = 0;
    let fetchTimer = 0;

    /* Generation counters, one per loop. Each loop captures its generation
       and only reschedules while it is still current, so a request that was
       in flight when Present closed (or the tab came back) can never start a
       second, parallel loop. Bumped on open, on close, and to stop a loop. */
    let codeGen = 0;
    let countGen = 0;

    /* ── Live tally ─────────────────────────────────────────────────────────
       Polls a count-only endpoint. Polling, not Supabase Realtime: realtime
       would need supabase-js in the browser plus an end-user token path, all
       to move one integer; one projector asking every 3s is nothing. The
       number is written with textContent only.
       Failures are never terminal: the guard answers 401/403 on a transient
       Supabase blip (and while "view as student" is on in another tab), so
       the loop keeps asking, slower, and the number dims after a few misses
       so a frozen count is visible rather than silent. */
    const COUNT_POLL_MS = 3_000;
    const COUNT_POLL_SLOW_MS = 15_000; // hidden tab, or after a failed poll
    const STALE_AFTER_FAILS = 3;
    let shownCount = Number(tallyEl.dataset.count ?? '0') || 0;
    let countTimer = 0;
    let countFails = 0;
    let countStopped = false; // check-in closed: the count can't change

    const setCount = (n: number) => {
      if (n === shownCount) return;
      const rose = n > shownCount;
      shownCount = n;
      tallyEl.textContent = String(n);
      if (factsCountEl) factsCountEl.textContent = String(n);
      if (rose) {
        // Restart the bump even if the last one is mid-flight.
        tallyEl.classList.remove('is-bump');
        void tallyEl.offsetWidth;
        tallyEl.classList.add('is-bump');
      }
    };

    const pollCount = async (gen: number) => {
      if (!isOpen || gen !== countGen) return;
      if (!document.hidden) {
        let ok = false;
        try {
          const res = await fetch(`/api/events/${encodeURIComponent(eventId)}/checkins`, {
            headers: { accept: 'application/json' },
            cache: 'no-store',
          });
          if (res.ok) {
            const body = await res.json();
            if (typeof body.count === 'number') {
              setCount(body.count);
              ok = true;
            }
          }
        } catch {
          /* network blip — keep the last number and try again */
        }
        countFails = ok ? 0 : countFails + 1;
        tallyEl.classList.toggle('is-stale', countFails >= STALE_AFTER_FAILS);
      }
      if (isOpen && gen === countGen) {
        countTimer = window.setTimeout(
          () => void pollCount(gen),
          document.hidden || countFails > 0 ? COUNT_POLL_SLOW_MS : COUNT_POLL_MS
        );
      }
    };
    const stopCount = () => {
      countStopped = true;
      countGen++;
      window.clearTimeout(countTimer);
    };

    const fmtCountdown = (ms: number) => {
      const s = Math.max(0, Math.ceil(ms / 1000));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };
    const tick = () => {
      if (!isOpen || refreshAtMs === 0) return;
      countEl.textContent = `Refreshes in ${fmtCountdown(refreshAtMs - Date.now())}`;
    };

    const fetchCode = async (gen: number) => {
      if (!isOpen || gen !== codeGen) return;
      const again = (ms: number) => {
        if (isOpen && gen === codeGen) fetchTimer = window.setTimeout(() => void fetchCode(gen), ms);
      };
      try {
        const res = await fetch(`/api/events/${encodeURIComponent(eventId)}/qr`, {
          headers: { accept: 'application/json' },
        });
        if (!isOpen || gen !== codeGen) return;
        if (!res.ok) {
          let msg = 'Could not fetch a check-in code.';
          try {
            const body = await res.json();
            if (body && typeof body.error === 'string') msg = body.error;
          } catch {
            /* keep fallback */
          }
          statusEl.textContent = msg;
          countEl.textContent = '';
          refreshAtMs = 0;
          // 404/409 = this event can no longer take check-ins (gone, over, or
          // cancelled): stop both loops — the count can't change any more.
          // 400 = unusable id: stop. Everything else (401/403 on a transient
          // auth blip, 5xx, …) retries shortly.
          if (res.status === 404 || res.status === 409) {
            stopCount();
            return;
          }
          if (res.status === 400) return;
          again(30_000);
          return;
        }
        const body = await res.json();
        if (typeof body.qr === 'string') qrImg.src = body.qr;
        statusEl.textContent = '';
        const expiresInS = typeof body.expires_in === 'number' ? body.expires_in : 900;
        const waitS = Math.max(expiresInS - REFRESH_MARGIN_S, 30);
        refreshAtMs = Date.now() + waitS * 1000;
        again(waitS * 1000);
        tick();
      } catch {
        if (!isOpen || gen !== codeGen) return;
        statusEl.textContent = 'Network error — retrying shortly.';
        countEl.textContent = '';
        refreshAtMs = 0;
        again(30_000);
      }
    };

    const openLayer = () => {
      isOpen = true;
      nameEl.textContent = eventTitle;
      statusEl.textContent = 'Fetching a fresh code…';
      countEl.textContent = '';
      countFails = 0;
      countStopped = false;
      tallyEl.classList.remove('is-stale');
      layer.style.display = 'grid';
      document.body.style.overflow = 'hidden';
      exitBtn.focus();
      void fetchCode(++codeGen);
      void pollCount(++countGen);
      tickTimer = window.setInterval(tick, 1000);
    };
    const closeLayer = () => {
      isOpen = false;
      codeGen++;
      countGen++;
      layer.style.display = 'none';
      document.body.style.overflow = '';
      window.clearInterval(tickTimer);
      window.clearTimeout(fetchTimer);
      window.clearTimeout(countTimer);
      refreshAtMs = 0;
      qrImg.removeAttribute('src');
      openBtn.focus();
    };

    // Back from a hidden tab: refresh the count now rather than after the
    // slow interval, so the room isn't looking at a stale number. A fresh
    // generation means a poll still in flight can't become a second loop.
    // A loop stopped because check-in closed stays stopped.
    document.addEventListener('visibilitychange', () => {
      if (isOpen && !document.hidden && !countStopped) {
        window.clearTimeout(countTimer);
        void pollCount(++countGen);
      }
    });

    openBtn.addEventListener('click', openLayer);

    // Arrived from the home page's "Present check-in code" (?present=1, already
    // stripped above): open straight into Present mode.
    if (arrivedToPresent) openLayer();
    exitBtn.addEventListener('click', closeLayer);
    document.addEventListener('keydown', (e) => {
      if (isOpen && e.key === 'Escape') closeLayer();
    });
  }
</script>
