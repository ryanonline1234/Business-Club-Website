---
/**
 * /calendar — RETIRED 2026-10-26 (owner decision: the calendar felt awkward;
 * /meetings is the hub). It renders nothing and reads nothing; it only sends
 * old links, bookmarks and printed URLs to where each thing lives now:
 *
 *   /calendar?event=<id>&present=1 → /meetings/<id>?present=1  (Present mode)
 *   /calendar?event=<id>           → /meetings/<id>
 *   /calendar?new=1                → /meetings?new=1           (New meeting form)
 *   /calendar (anything else)      → /meetings
 *
 * NO GUARD, BY DESIGN: there is nothing here to protect, and the destinations
 * apply their own rules (/meetings is public; Present is officers-only on the
 * meeting page). `event` must be a UUID before it is put in a path. 302, not
 * 301, so bringing a calendar back never fights a browser's cached redirect.
 */
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const params = Astro.url.searchParams;
const eventId = params.get('event') ?? '';

let target = '/meetings';
if (UUID_RE.test(eventId)) {
  target = `/meetings/${eventId}${params.get('present') === '1' ? '?present=1' : ''}`;
} else if (params.get('new') === '1') {
  target = '/meetings?new=1';
}

return Astro.redirect(target, 302);
---
