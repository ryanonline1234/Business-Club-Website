---
/**
 * /login — the entry gate. Public, standalone (no DashboardLayout).
 *
 * Error copy is a FIXED map keyed by ?error= — the callback only ever emits
 * 'domain' | 'auth-error' | 'pending' (see api/auth/callback.ts), and nothing
 * from the query string is ever reflected into the page. A valid same-origin
 * ?next= path is forwarded to /api/auth/signin, which stashes it in a cookie
 * for the OAuth callback to consume.
 */
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/libre-baskerville/latin-400.css';
import '@fontsource/libre-baskerville/latin-600.css';
import '@fontsource/libre-baskerville/latin-700.css';
import { getSession } from '../lib/auth';
import { safeNextPath } from '../lib/next-redirect';

const session = await getSession(Astro.request, Astro.response.headers);
if (session) return Astro.redirect(session.isApproved ? '/' : '/pending');

/** The only strings this page may show for ?error=. Unknown keys render nothing. */
const ERROR_COPY: Record<string, string> = {
  domain:
    'Use your school Google account — @mittymonarch.com for students, @mitty.com for faculty.',
  'auth-error': 'Sign-in failed. Please try again.',
  pending: 'Your account is awaiting officer approval.',
};
const errorKey = Astro.url.searchParams.get('error');
const errorMessage = errorKey ? (ERROR_COPY[errorKey] ?? null) : null;

// Forward "where was I going" through the OAuth round trip. safeNextPath is
// the canonical open-redirect check (root-relative, same-origin, non-auth
// paths only) — anything it rejects is simply dropped.
const nextPath = safeNextPath(Astro.url.searchParams.get('next'));
const signinHref = nextPath
  ? `/api/auth/signin?next=${encodeURIComponent(nextPath)}`
  : '/api/auth/signin';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <title>Sign in — Mitty Business Club</title>
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <!-- Club monogram, defined once for this standalone page. -->
  <svg width="0" height="0" class="svgdefs" aria-hidden="true" focusable="false">
    <defs>
      <g id="monogram" fill="none">
        <circle cx="20" cy="20" r="18.25" stroke="#8E7B48" stroke-width="1.3"/>
        <path d="M11 27.4h18M11 27.4V14.6l4.6 5.2L20 12l4.4 7.8 4.6-5.2v12.8" stroke="#8E7B48" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="M20 6.4v3.4M18.4 8.1h3.2" stroke="#8E7B48" stroke-width="1.3" stroke-linecap="round"/>
      </g>
    </defs>
  </svg>

  <div class="sheet">
    <header class="pmark">
      <svg width="22" height="22" viewBox="0 0 40 40" aria-hidden="true"><use href="#monogram"/></svg>
      <span>Mitty Business Club</span>
    </header>

    <main class="gate">
      <svg class="gate__mark" width="72" height="72" viewBox="0 0 40 40" aria-hidden="true"><use href="#monogram"/></svg>
      <h1>Member sign in</h1>
      <p class="gate__sub">Meetings, announcements and check-ins for members and officers.</p>

      {errorMessage && <p class="gate__notice" role="alert">{errorMessage}</p>}

      <a class="btn btn--wide gate__go" href={signinHref}>Sign in with Google</a>

      <p class="gate__foot">
        Sign in with your school Google account — you&rsquo;re in right away.
      </p>

      <p class="gate__about">
        New here? <a href="/about">See what the club does</a>
      </p>
    </main>
  </div>
</body>
</html>

<style>
  /* Page-local composition only — tokens and primitives come from global.css. */
  .gate{
    flex:1;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    padding:6vh 0 10vh;
  }
  .gate__mark{ flex:none; }
  .gate h1{
    margin-top:20px;
    font-family:var(--f-serif); font-weight:600;
    font-size:var(--t-34); line-height:1.1; color:var(--ink);
  }
  .gate__sub{
    margin-top:10px;
    font-size:var(--t-16); color:var(--ink-3); line-height:1.55;
    max-width:32ch;
  }
  .gate__notice{
    margin-top:24px; width:100%; text-align:left;
    border:1px solid var(--clay); border-left-width:3px;
    background:var(--clay-bg); color:var(--ink);
    border-radius:0 var(--r) var(--r) 0;
    padding:12px 14px;
    font-size:var(--t-14); line-height:1.5;
  }
  .gate__go{ margin-top:24px; min-height:56px; }
  .gate__foot{
    margin-top:14px;
    font-size:var(--t-12); color:var(--ink-3); line-height:1.6;
    max-width:36ch;
  }
  .gate__about{
    margin-top:28px;
    font-size:var(--t-12); color:var(--ink-3); line-height:1.6;
  }
  .gate__about a{ color:var(--ink-3); }
</style>
