---
/**
 * /attendance — scoped by role.
 *
 * Officers see the full club log: per-event turnout for the recent five
 * meetings, headline figures, and the member/event/time table. They can also
 * check people in by email (POST /api/attendance/manual — the board or sheet
 * after a meeting) and remove a check-in from the log (DELETE
 * /api/attendance/:id).
 * Members see ONLY their own check-in history and their own totals — no
 * other members' rows, no emails. (The previous version showed the entire
 * club-wide log to every member; that scoping bug is what this fixes.)
 *
 * All day-bucketing uses Pacific date keys — the club is in
 * America/Los_Angeles and the server runs in UTC.
 */
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { requireApproved } from '../lib/auth';
import { supabaseAdmin } from '../lib/supabase';
import { CHECKIN_OPENS_BEFORE_MS } from '../lib/event-time';

const session = await requireApproved(Astro.request, Astro.response.headers, Astro.redirect);

const TZ = 'America/Los_Angeles';
const dayKey = (value: string | Date): string =>
  new Date(value).toLocaleDateString('en-CA', { timeZone: TZ });
const todayKey = dayKey(new Date());
const fmtDay = (value: string): string =>
  new Date(value).toLocaleDateString('en-US', { timeZone: TZ, month: 'short', day: 'numeric' });
const fmtTime = (value: string): string =>
  new Date(value).toLocaleTimeString('en-US', { timeZone: TZ, hour: 'numeric', minute: '2-digit' });
const longToday = new Date().toLocaleDateString('en-US', {
  timeZone: TZ,
  weekday: 'long',
  month: 'long',
  day: 'numeric',
});

/** Supabase embeds come back as object or single-element array depending on the FK metadata. */
function one<T>(value: T | T[] | null | undefined): T | null {
  if (value === null || value === undefined) return null;
  return Array.isArray(value) ? (value[0] ?? null) : value;
}

const clampPct = (n: number): number => Math.max(0, Math.min(100, Math.round(n)));

const nowIso = new Date().toISOString();

// Meetings held so far (both branches use this): non-cancelled events that
// have already started.
const { count: meetingsHeldCount } = await supabaseAdmin
  .from('events')
  .select('id', { count: 'exact', head: true })
  .in('status', ['active', 'completed'])
  .lte('start_time', nowIso);
const meetingsHeld = meetingsHeldCount ?? 0;

/* ── Officer data ─────────────────────────────────────────────────────── */

const LOG_LIMIT = 400;
/** Meeting sheets listed on this page; older meetings' PDFs are on their meeting pages. */
const SHEETS_LIMIT = 60;
/** Listed openly above the log; the rest fold into "Older meetings". */
const SHEETS_SHOWN = 6;

interface LogRow {
  id: string;
  name: string;
  eventId: string;
  eventTitle: string;
  when: string;
  method: string;
}
interface TurnoutRow {
  label: string;
  isToday: boolean;
  count: number;
  pct: number;
}
interface FilterEvent {
  id: string;
  label: string;
}
interface SheetRow {
  id: string;
  title: string;
  day: string;
  isToday: boolean;
  count: number;
}

let logRows: LogRow[] = [];
let filterEvents: FilterEvent[] = [];
let turnout: TurnoutRow[] = [];
let approvedCount = 0;
let totalCheckins = 0;
let avgTurnout = 0;
let sheets: SheetRow[] = [];
let sheetsFailed = false;

if (session.isOfficer) {
  const { data: log } = await supabaseAdmin
    .from('attendance')
    .select(
      'id, checked_in_at, method, event_id, profiles:member_id ( name ), events:event_id ( title, start_time )'
    )
    .order('checked_in_at', { ascending: false })
    .limit(LOG_LIMIT);

  const { count: approved } = await supabaseAdmin
    .from('profiles')
    .select('id', { count: 'exact', head: true })
    .eq('status', 'approved');
  approvedCount = approved ?? 0;

  const { count: checkins } = await supabaseAdmin
    .from('attendance')
    .select('id', { count: 'exact', head: true });
  totalCheckins = checkins ?? 0;

  // Recent five meetings for the turnout bars: fetch a generous window, then
  // keep only events whose Pacific-local day is today or earlier.
  const { data: recentEvents } = await supabaseAdmin
    .from('events')
    .select('id, title, start_time')
    .in('status', ['active', 'completed'])
    .order('start_time', { ascending: false })
    .limit(25);

  const turnoutEvents = (recentEvents ?? [])
    .filter((e) => e.start_time && dayKey(e.start_time) <= todayKey)
    .slice(0, 5)
    .reverse();

  const countsByEvent = new Map<string, number>();
  if (turnoutEvents.length > 0) {
    const { data: countRows } = await supabaseAdmin
      .from('attendance')
      .select('event_id')
      .in(
        'event_id',
        turnoutEvents.map((e) => e.id)
      );
    for (const row of countRows ?? []) {
      countsByEvent.set(row.event_id, (countsByEvent.get(row.event_id) ?? 0) + 1);
    }
  }

  turnout = turnoutEvents.map((e) => {
    const count = countsByEvent.get(e.id) ?? 0;
    return {
      label: fmtDay(e.start_time),
      isToday: dayKey(e.start_time) === todayKey,
      count,
      pct: approvedCount > 0 ? clampPct((count / approvedCount) * 100) : 0,
    };
  });

  avgTurnout =
    meetingsHeld > 0 && approvedCount > 0
      ? clampPct((totalCheckins / (meetingsHeld * approvedCount)) * 100)
      : 0;

  const seenEvents = new Map<string, { label: string; start: string }>();
  logRows = (log ?? []).map((r) => {
    const profile = one<{ name: string | null }>(r.profiles);
    const event = one<{ title: string | null; start_time: string | null }>(r.events);
    const title = event?.title ?? 'Unknown event';
    if (r.event_id && !seenEvents.has(r.event_id)) {
      seenEvents.set(r.event_id, {
        label: event?.start_time ? `${title} — ${fmtDay(event.start_time)}` : title,
        start: event?.start_time ?? '',
      });
    }
    return {
      id: r.id as string,
      name: profile?.name?.trim() || 'Unknown member',
      eventId: r.event_id ?? '',
      eventTitle: title,
      when: r.checked_in_at ? `${fmtDay(r.checked_in_at)} · ${fmtTime(r.checked_in_at)}` : '—',
      // 'manual' = an officer checked them in by email (STEP 21).
      method: r.method === 'qr' ? 'QR' : r.method === 'manual' ? 'Officer' : 'Code',
    };
  });

  // Meeting sheets: the SHEETS_LIMIT most recent meetings whose check-in
  // window has opened (start − 30 min, the check-in endpoint's own rule),
  // newest first, each with a PDF; older ones are on each meeting's own
  // page. Cancelled meetings are left out of the list (the endpoint still
  // serves them). The embedded count is one query, not one per meeting.
  const sheetsOpenBefore = new Date(Date.now() + CHECKIN_OPENS_BEFORE_MS).toISOString();
  const { data: sheetEvents, error: sheetsError } = await supabaseAdmin
    .from('events')
    .select('id, title, start_time, attendance(count)')
    .in('status', ['active', 'completed'])
    .lte('start_time', sheetsOpenBefore)
    .order('start_time', { ascending: false })
    .limit(SHEETS_LIMIT);
  if (sheetsError) {
    sheetsFailed = true;
    console.error('[pages/attendance] meeting sheets read failed', { message: sheetsError.message });
  }
  sheets = (sheetEvents ?? []).map((e: any) => ({
    id: e.id as string,
    title: (e.title as string) ?? 'Untitled',
    day: fmtDay(e.start_time),
    isToday: dayKey(e.start_time) === todayKey,
    count: one<{ count: number }>(e.attendance)?.count ?? 0,
  }));

  filterEvents = [...seenEvents.entries()]
    .sort((a, b) => (a[1].start < b[1].start ? 1 : -1))
    .map(([id, v]) => ({ id, label: v.label }));
}

const logCapped = logRows.length === LOG_LIMIT;
const turnoutHasToday = turnout.some((t) => t.isToday);

/* ── Member data (own rows only) ──────────────────────────────────────── */

interface MineRow {
  isToday: boolean;
  day: string;
  time: string;
  title: string;
}

let mineRows: MineRow[] = [];
let mineCount = 0;
let mineRate = 0;

if (!session.isOfficer) {
  const { data: mine } = await supabaseAdmin
    .from('attendance')
    .select('checked_in_at, events:event_id ( title )')
    .eq('member_id', session.id)
    .order('checked_in_at', { ascending: false });

  mineRows = (mine ?? []).map((r) => {
    const event = one<{ title: string | null }>(r.events);
    return {
      isToday: r.checked_in_at ? dayKey(r.checked_in_at) === todayKey : false,
      day: r.checked_in_at ? fmtDay(r.checked_in_at) : '—',
      time: r.checked_in_at ? fmtTime(r.checked_in_at) : '',
      title: event?.title ?? 'Unknown event',
    };
  });
  mineCount = mineRows.length;
  mineRate = meetingsHeld > 0 ? clampPct((mineCount / meetingsHeld) * 100) : 0;
}
---
<DashboardLayout title="Attendance" user={session}>
  <header class="greet">
    <span class="greet__date">{longToday}</span>
    <h1>{session.isOfficer ? 'Attendance' : 'Your attendance'}</h1>
    {session.isOfficer ? (
      <p>Who showed up, meeting by meeting.</p>
    ) : (
      <p>Your own check-in history. Only you and the officers can see it.</p>
    )}
  </header>

  {session.isOfficer ? (
    <div class="home" style="margin-top:clamp(28px,3.6vw,42px)">
      <div class="home__main">
        {/* Meeting sheets come FIRST: the PDF is usually what an officer opened
            this page for, and the check-in log under it can run to 400 rows.
            The newest few are listed; the rest fold into "Older meetings"
            (native <details>, no script). */}
        <section aria-labelledby="sheets-h" class="owned">
          <div class="section-head">
            <h2 id="sheets-h">Meeting sheets</h2>
            <span class="spacer"></span>
            <span class="flag">Officer only</span>
          </div>
          <p class="small muted sheets__lede">
            One PDF per meeting, named for its date: every attendee with their email and
            check-in time. It has members&rsquo; emails on it — share it with care.
          </p>
          {sheetsFailed ? (
            <div class="state">
              <b>Couldn&rsquo;t load the meetings</b>
              <p>Reload the page to try again.</p>
            </div>
          ) : sheets.length > 0 ? (
            <>
              <ul class="sheets">
                {sheets.slice(0, SHEETS_SHOWN).map((m) => (
                  <li>
                    <span class="sheets__when">{m.isToday ? <span class="hl">Today</span> : m.day}</span>
                    <a class="sheets__title" href={`/meetings/${encodeURIComponent(m.id)}`}>{m.title}</a>
                    <span class="sheets__n"><span class="num">{m.count}</span> in</span>
                    <a
                      class="btn btn--sm btn--ghost sheets__dl"
                      href={`/api/events/${encodeURIComponent(m.id)}/attendance.pdf`}
                      download
                      aria-label={`Download the attendance PDF for ${m.title}, ${m.day}`}
                    >PDF</a>
                  </li>
                ))}
              </ul>
              {sheets.length > SHEETS_SHOWN && (
                <details class="sheets__older">
                  <summary>Older meetings ({sheets.length - SHEETS_SHOWN})</summary>
                  <ul class="sheets">
                    {sheets.slice(SHEETS_SHOWN).map((m) => (
                      <li>
                        <span class="sheets__when">{m.day}</span>
                        <a class="sheets__title" href={`/meetings/${encodeURIComponent(m.id)}`}>{m.title}</a>
                        <span class="sheets__n"><span class="num">{m.count}</span> in</span>
                        <a
                          class="btn btn--sm btn--ghost sheets__dl"
                          href={`/api/events/${encodeURIComponent(m.id)}/attendance.pdf`}
                          download
                          aria-label={`Download the attendance PDF for ${m.title}, ${m.day}`}
                        >PDF</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </>
          ) : (
            <div class="state">
              <b>No meetings yet</b>
              <p>Each meeting gets a downloadable sheet once its check-in opens.</p>
            </div>
          )}
        </section>

        {/* Check people in by email: for anyone who couldn't scan the code and
            wrote their email on the board or a sheet. Shares the add-members
            panel's look (global .addm styles). */}
        <section aria-labelledby="mci-h" class="owned addm" id="check-in">
          <div class="section-head">
            <h2 id="mci-h">Check someone in</h2>
            <span class="spacer"></span>
            <span class="flag">Officer only</span>
          </div>
          <p class="small muted addm__lede">
            Someone couldn&rsquo;t scan the code and wrote their email on the board? Type it
            in here, even after the meeting. They show up on that meeting&rsquo;s PDF right
            away. If they don&rsquo;t have an account yet, one is made for them, and the
            check-in is already on it when they first sign in with Google.
          </p>
          {sheets.length > 0 ? (
            <details class="addm__wrap" open={Astro.url.searchParams.has('checkin')}>
              <summary>Check people in by email</summary>
              <form class="addm__form" id="mci-form" novalidate>
                <label class="field">
                  <span>Meeting</span>
                  <select class="select" id="mci-event">
                    {sheets.map((m) => (
                      <option value={m.id}>{m.isToday ? 'Today' : m.day} · {m.title}</option>
                    ))}
                  </select>
                </label>
                <label class="field">
                  <span>Emails — one per line</span>
                  <textarea
                    class="textarea"
                    id="mci-text"
                    rows="5"
                    placeholder={"avachen28@mittymonarch.com\nNoah Kim, noahkim27@mittymonarch.com"}
                  ></textarea>
                  <span class="field__hint">
                    School addresses only. A name beside an email is used for a new account until
                    they first sign in.
                  </span>
                </label>
                <button class="btn btn--sm" type="submit" id="mci-go">Check in</button>
                <span class="row-err" id="mci-err" role="alert" style="display:none"></span>
              </form>
              <div id="mci-out" class="addm__out" hidden></div>
            </details>
          ) : (
            <div class="state">
              <b>No meetings to check people in to yet</b>
              <p>A meeting shows up here once its check-in opens, 30 minutes before it starts.</p>
            </div>
          )}
        </section>

        <section aria-labelledby="log-h" class="owned">
          <div class="section-head">
            <h2 id="log-h">Check-in log</h2>
            <span class="spacer"></span>
            <span class="count"><span class="num">{totalCheckins}</span> check-ins</span>
            <span class="flag">Officer only</span>
          </div>

          {logRows.length > 0 ? (
            <>
              <div class="roster-tools">
                <label class="field" style="flex:1 1 200px">
                  <span class="sr">Search by member name</span>
                  <input
                    class="input"
                    type="search"
                    id="att-search"
                    placeholder="Search by name…"
                    autocomplete="off"
                  />
                </label>
                <label class="field" style="flex:0 1 280px;min-width:180px">
                  <span class="sr">Filter by event</span>
                  <select class="select" id="att-event">
                    <option value="">All events</option>
                    {filterEvents.map((e) => (
                      <option value={e.id}>{e.label}</option>
                    ))}
                  </select>
                </label>
              </div>

              <div class="tablewrap">
                <table class="rows" id="att-table">
                  <thead>
                    <tr>
                      <th>Member</th>
                      <th>Event</th>
                      <th>When</th>
                      <th>Method</th>
                      <th><span class="sr">Remove</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {logRows.map((r) => (
                      <tr data-event={r.eventId} data-name={r.name.toLowerCase()}>
                        <td data-label="Member">{r.name}</td>
                        <td data-label="Event">{r.eventTitle}</td>
                        <td data-label="When"><span class="num">{r.when}</span></td>
                        <td data-label="Method">{r.method}</td>
                        <td>
                          <button
                            class="btn btn--sm btn--danger"
                            type="button"
                            data-remove={r.id}
                            data-who={r.name}
                            data-what={r.eventTitle}
                            aria-label={`Remove ${r.name}'s check-in for ${r.eventTitle}`}
                          >Remove</button>
                          <span class="row-err" role="alert" style="display:none"></span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div class="state" id="att-none" style="display:none">
                <b>No matches</b>
                <p>No check-ins match that search. Clear it and try again.</p>
              </div>

              {logCapped && (
                <p class="micro muted" style="margin-top:10px">
                  Showing the <span class="num">{LOG_LIMIT}</span> most recent check-ins.
                </p>
              )}
            </>
          ) : (
            <div class="state state--rule">
              <b>No check-ins recorded yet</b>
              <p>
                Project a QR code at your next meeting and every scan lands here, newest
                first.
              </p>
            </div>
          )}
        </section>
      </div>

      <aside class="home__rail">
        <section aria-labelledby="fig-h">
          <div class="section-head"><h2 id="fig-h">By the numbers</h2></div>
          <div class="figures">
            <div>
              <b>{approvedCount}</b>
              <span class="figures__cap">Approved<br />members</span>
            </div>
            <div>
              <b>{meetingsHeld}</b>
              <span class="figures__cap">Meetings<br />held</span>
            </div>
            <div>
              <b>{totalCheckins}</b>
              <span class="figures__cap">Check-ins<br />recorded</span>
            </div>
            <div>
              <b>{avgTurnout}<span class="figures__unit">%</span></b>
              <span class="figures__cap">Average<br />turnout</span>
            </div>
          </div>
        </section>

        <section aria-labelledby="turn-h">
          <div class="section-head">
            <h2 id="turn-h">Turnout, recent five</h2>
            <span class="spacer"></span>
            <span class="count">of {approvedCount}</span>
          </div>
          {turnout.length > 0 ? (
            <>
              <ul class="turnout">
                {turnout.map((t) => (
                  <li class:list={[{ now: t.isToday }]}>
                    <span class="lbl">{t.isToday ? <span class="hl">Today</span> : t.label}</span>
                    <span class="bar" aria-hidden="true"><i style={`width:${t.pct}%`}></i></span>
                    <span class="pct">
                      {t.pct}%<span class="sr"> — {t.count} of {approvedCount} checked in</span>
                    </span>
                  </li>
                ))}
              </ul>
              {turnoutHasToday && (
                <p class="small muted" style="margin-top:10px">
                  Today is still counting.
                </p>
              )}
            </>
          ) : (
            <div class="state">
              <b>No meetings yet</b>
              <p>Turnout bars show up after the first event.</p>
            </div>
          )}
        </section>
      </aside>
    </div>
  ) : (
    <div class="home" style="margin-top:clamp(28px,3.6vw,42px)">
      <div class="home__main">
        <section aria-labelledby="tot-h">
          <div class="section-head"><h2 id="tot-h">Your totals</h2></div>
          <div class="figures">
            <div>
              <b>{mineCount}</b>
              <span class="figures__cap">Meetings<br />attended</span>
            </div>
            <div>
              <b>{mineRate}<span class="figures__unit">%</span></b>
              <span class="figures__cap">Of {meetingsHeld} held<br />so far</span>
            </div>
          </div>
        </section>

        <section aria-labelledby="hist-h">
          <div class="section-head">
            <h2 id="hist-h">Your check-ins</h2>
            <span class="spacer"></span>
            <span class="count"><span class="num">{mineCount}</span> total</span>
          </div>
          {mineRows.length > 0 ? (
            <ul class="minilist">
              {mineRows.map((m) => (
                <li>
                  <span class="when">{m.isToday ? <span class="hl">Today</span> : m.day}</span>
                  <span class="what">
                    {m.title}
                    {m.time && <span class="micro muted"> · {m.time}</span>}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="state state--rule">
              <b>No check-ins yet</b>
              <p>
                Scan the QR code an officer puts up at a meeting and your history lands
                here.
              </p>
            </div>
          )}
        </section>
      </div>
    </div>
  )}

  {session.isOfficer && (
    <script is:inline>
      (function () {
        var search = document.getElementById('att-search');
        var eventSel = document.getElementById('att-event');
        var table = document.getElementById('att-table');
        var none = document.getElementById('att-none');
        if (!search || !eventSel || !table) return;

        function apply() {
          var q = search.value.trim().toLowerCase();
          var ev = eventSel.value;
          var rows = table.querySelectorAll('tbody tr');
          var visible = 0;
          rows.forEach(function (row) {
            var matchEvent = !ev || row.getAttribute('data-event') === ev;
            var matchName = !q || (row.getAttribute('data-name') || '').indexOf(q) !== -1;
            var show = matchEvent && matchName;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          if (none) none.style.display = visible === 0 ? '' : 'none';
          table.parentElement.style.display = visible === 0 ? 'none' : '';
        }

        search.addEventListener('input', apply);
        eventSel.addEventListener('change', apply);
      })();
    </script>
  )}
</DashboardLayout>

<script>
  /* ── Check someone in, and remove a check-in (officer) ─────────────────────
     Results are rendered with createElement + textContent. Never innerHTML:
     these strings include addresses and names typed by a person. Both
     elements only exist for officers, so for members this does nothing. */
  {
    const form = document.getElementById('mci-form') as HTMLFormElement | null;
    const eventSel = document.getElementById('mci-event') as HTMLSelectElement | null;
    const text = document.getElementById('mci-text') as HTMLTextAreaElement | null;
    const go = document.getElementById('mci-go') as HTMLButtonElement | null;
    const err = document.getElementById('mci-err') as HTMLElement | null;
    const out = document.getElementById('mci-out') as HTMLElement | null;

    if (form && eventSel && text && go && err && out) {
      const showErr = (msg: string) => {
        err.textContent = msg;
        err.style.display = '';
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        err.style.display = 'none';
        out.hidden = true;
        out.replaceChildren();

        const body = text.value.trim();
        if (!body) return showErr('Type at least one email address.');

        go.disabled = true;
        const label = go.textContent;
        go.textContent = 'Checking in…';

        try {
          const res = await fetch('/api/attendance/manual', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ event_id: eventSel.value, text: body }),
          });
          const payload = await res.json().catch(() => null);

          if (!res.ok) {
            showErr(payload?.error ?? 'Could not check those people in.');
            return;
          }

          const s = payload?.summary ?? { checked_in: 0, created: 0, already: 0, rejected: 0 };
          const head = document.createElement('b');
          const parts = [s.checked_in + s.created + ' checked in'];
          if (s.created) parts.push(s.created + (s.created === 1 ? ' new account' : ' new accounts'));
          if (s.already) parts.push(s.already + ' already checked in');
          if (s.rejected) parts.push(s.rejected + ' skipped');
          head.textContent = parts.join(' · ');
          out.append(head);

          // Only the problems need itemising; the rest shows in the log on reload.
          const bad = (payload?.results ?? []).filter((r: any) => r.outcome === 'rejected');
          if (bad.length) {
            const ul = document.createElement('ul');
            ul.className = 'addm__bad';
            for (const r of bad) {
              const li = document.createElement('li');
              const who = document.createElement('span');
              who.textContent = r.email;
              const why = document.createElement('em');
              why.textContent = r.reason ?? 'Skipped.';
              li.append(who, document.createTextNode(' — '), why);
              ul.append(li);
            }
            out.append(ul);
          }
          out.hidden = false;

          if (s.checked_in + s.created > 0) {
            // Reload so the sheet counts and the log show the new rows; keep
            // the form open.
            setTimeout(() => {
              const url = new URL(location.href);
              url.searchParams.set('checkin', '1');
              url.hash = 'check-in';
              location.href = url.toString();
            }, 1400);
          } else {
            text.focus();
          }
        } catch {
          showErr('Network problem — no one was checked in. Try again.');
        } finally {
          go.disabled = false;
          go.textContent = label;
        }
      });
    }

    const table = document.getElementById('att-table');
    table?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-remove]');
      if (!btn) return;
      const who = btn.dataset.who ?? 'this member';
      const what = btn.dataset.what ?? 'this meeting';
      if (!confirm(`Remove ${who}'s check-in for ${what}? It comes off the meeting's PDF too.`)) return;

      const rowErr = btn.parentElement?.querySelector<HTMLElement>('.row-err') ?? null;
      if (rowErr) rowErr.style.display = 'none';
      btn.disabled = true;
      try {
        const res = await fetch(`/api/attendance/${encodeURIComponent(btn.dataset.remove ?? '')}`, {
          method: 'DELETE',
        });
        const payload = await res.json().catch(() => null);
        if (!res.ok && res.status !== 404) {
          if (rowErr) {
            rowErr.textContent = payload?.error ?? 'Could not remove it.';
            rowErr.style.display = '';
          }
          btn.disabled = false;
          return;
        }
        // Gone (or already gone): drop the row now; counts catch up on reload.
        btn.closest('tr')?.remove();
      } catch {
        if (rowErr) {
          rowErr.textContent = 'Network problem — nothing was removed.';
          rowErr.style.display = '';
        }
        btn.disabled = false;
      }
    });
  }
</script>
