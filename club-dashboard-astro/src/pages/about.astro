h1,h2,h3,p,figure,figcaption,ul,ol{margin:0}
ul,ol{list-style:none;padding:0}
::selection{background:var(--gold);color:var(--black)}

:focus-visible{outline:3px solid var(--goldtext);outline-offset:2px}
.mast :focus-visible,.band :focus-visible,.night :focus-visible{outline-color:currentColor}
/* The gold buttons compute BLACK text — currentColor would put a black ring
   on a black plane. The primary actions get a bone ring on the dark planes;
   the 2px offset shows the plane between fill and ring, so it reads even
   when the hover state turns the fill bone. */
.mast .btn.gold:focus-visible,.night .btn.gold:focus-visible{outline-color:var(--bone)}

/* ---------- TYPE UTILITIES ---------- */
.dsp{
  font-family:var(--display);
  font-weight:800;
  text-transform:uppercase;
