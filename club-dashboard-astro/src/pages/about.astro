    html.js .ml.in:not(.m3){color:var(--text)}
  }
  html.js .m3 .mslab{clip-path:inset(0 100% 0 0);transition:clip-path 700ms var(--ease-rise) 150ms}
  html.js .m3.in .mslab{clip-path:inset(0 0 0 0)}

