  <!-- Scroll choreography + ambient details. is:inline so it ships in the
       document itself — no separate module fetch to fail. Mutates classList,
       textContent and style transforms only; never builds HTML from data. -->
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var fine = window.matchMedia('(pointer: fine)').matches;
      var items = Array.prototype.slice.call(document.querySelectorAll('.io'));
      var hn = document.querySelector('.hn');

      function settleAll() {
        items.forEach(function (el) { el.classList.add('in'); });
      }

      /* ── The live San Jose clock. Decorative (aria-hidden); seconds only
         when motion is welcome, minutes otherwise. */
      var ck = document.querySelector('[data-clock]');
      if (ck) {
        var tick = function () {
          try {
            var t = new Intl.DateTimeFormat('en-US', {
              timeZone: 'America/Los_Angeles',
              hour: 'numeric',
              minute: '2-digit',
              second: reduce ? undefined : '2-digit',
              hour12: true
            }).format(new Date());
            ck.textContent = 'San Jose · ' + t + ' PT';
          } catch (err) { /* keep the static fallback text */ }
        };
        tick();
        setInterval(tick, reduce ? 15000 : 1000);
      }

      /* ── The poster numeral counts 0 → N as its band reveals. Below 5 the
         count is a two-frame flicker, not a payoff — the server-rendered
         numeral simply rises in its slab. */
      function countUp() {
        if (!hn || reduce) return;
        var target = parseInt(hn.getAttribute('data-n') || '0', 10);
        if (!isFinite(target) || target < 5) return;
        var t0 = null;
        var dur = 700;
        function step(t) {
          if (t0 === null) t0 = t;
          var p = Math.min((t - t0) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3); /* ease-out cubic */
          var v = String(Math.round(eased * target));
          hn.textContent = v.length < 2 ? '0' + v : v;
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      /* ── Square cursor: dot tracks raw, ring lerps behind. Difference
         blend, fine pointers only, and never under reduced motion. */
      if (fine && !reduce) {
        var cd = document.querySelector('.curd');
        var cr = document.querySelector('.curr');
        if (cd && cr) {
          var mx = -100, my = -100, rx = -100, ry = -100, live = false;
          document.addEventListener('mousemove', function (e) {
            mx = e.clientX; my = e.clientY;
            if (!live) {
              live = true; rx = mx; ry = my;
              document.documentElement.classList.add('curlive');
            }
          }, { passive: true });
          document.addEventListener('mouseover', function (e) {
            var hit = e.target && e.target.closest
              ? e.target.closest('a, button, .brief, .ph, .off') : null;
            cr.classList.toggle('grow', !!hit);
          }, { passive: true });
          (function loop() {
            rx += (mx - rx) * 0.16;
            ry += (my - ry) * 0.16;
            cd.style.transform = 'translate3d(' + mx + 'px,' + my + 'px,0)';
            cr.style.transform = 'translate3d(' + rx + 'px,' + ry + 'px,0)';
            requestAnimationFrame(loop);
          })();
        }

        /* Magnetic primaries — a small pull toward the cursor, capped. */
        Array.prototype.forEach.call(document.querySelectorAll('[data-mag]'), function (el) {
          el.addEventListener('mousemove', function (e) {
            var b = el.getBoundingClientRect();
            var dx = (e.clientX - (b.left + b.width / 2)) * 0.22;
            var dy = (e.clientY - (b.top + b.height / 2)) * 0.28;
            dx = Math.max(-10, Math.min(10, dx));
            dy = Math.max(-8, Math.min(8, dy));
            el.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
          }, { passive: true });
          el.addEventListener('mouseleave', function () {
            el.style.transform = '';
          });
        });
      }

      if (reduce || !('IntersectionObserver' in window)) {
        settleAll();
        return;
      }
      try {
        var io = new IntersectionObserver(function (entries, obs) {
          /* Stagger PER BATCH: whatever reveals together staggers together
             (60ms, capped). An element arriving alone gets ZERO delay —
             scrolled-to content must never lag the scroll. */
          var k = 0;
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.style.transitionDelay = (Math.min(k, 6) * 60) + 'ms';
            k += 1;
            entry.target.classList.add('in');
            obs.unobserve(entry.target);
            if (entry.target.classList.contains('lockup')) countUp();
          });
        }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });

        /* At the top of the page the masthead choreography (~950ms) is
           playing; hold the first reveals until the title settles so two
           entrances never compete. Arriving mid-page, start at once. */
        var atTop = (window.scrollY || window.pageYOffset || 0) < 40;
        setTimeout(function () {
          items.forEach(function (el) { io.observe(el); });
        }, atTop ? 700 : 0);
      } catch (err) {
        settleAll();
      }
    })();
  </script>

</body>
