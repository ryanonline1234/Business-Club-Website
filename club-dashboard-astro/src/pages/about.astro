}
.btn:hover{background:var(--gold);border-color:var(--black);color:var(--black)}
.btn:active{transform:translateY(2px)}
/* gold never floats on a light ground — it always carries a black edge */
.btn.gold{background:var(--gold);border-color:var(--black);color:var(--black)}
.btn.gold:hover{background:var(--bone);border-color:var(--black);color:var(--black)}
.night .btn.ghost{background:transparent;border-color:var(--night-fg);color:var(--night-fg)}
.night .btn.ghost:hover{background:var(--night-fg);color:var(--night-bg)}

/* ---------- MASTHEAD — the full-viewport poster ---------- */
.mast{
  background:var(--mast-bg);color:var(--mast-fg);
  display:flex;flex-direction:column;
  min-height:100svh;
  padding:18px 0 0;
}
.topline{
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
