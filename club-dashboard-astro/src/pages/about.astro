/* ---------- MICRO-INTERACTIONS (hover/press) ----------
   150ms decelerate. box-shadow on .ini2 is paint, not composite — accepted
   on a 52px tile for the offset-print misregistration effect. */
.off .ini2{transition:transform var(--t-micro) var(--ease-out),box-shadow var(--t-micro) var(--ease-out)}
.off:hover .ini2{transform:translate(-3px,-3px);box-shadow:3px 3px 0 var(--signal)}
.brief .ttl{transition:transform var(--t-micro) var(--ease-out)}
