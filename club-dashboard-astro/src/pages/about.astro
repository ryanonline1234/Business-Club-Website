}
.lab,.micro{font-family:var(--ui);font-weight:800;text-transform:uppercase;line-height:1.3}
.lab{font-size:var(--lab-size);letter-spacing:var(--lab-track)}
.micro{font-size:var(--micro-size);letter-spacing:var(--micro-track)}

.wrap{max-width:var(--frame);margin:0 auto;padding-left:var(--gut);padding-right:var(--gut)}

/* ---------- PRINT DETAILS (shared) ---------- */
/* Grain sits between each plane's background and its content — loud enough
   to SEE at arm's length (texture nobody can perceive is decoration serving
   nobody). The gold plane carries the most; ink still wins on contrast. */
.mast,.band,.night{position:relative;isolation:isolate}
