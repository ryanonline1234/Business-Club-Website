---
/**
 * /about — the PUBLIC showcase page. The one page you'd show a student who
 * has never joined: what the club has done (recaps + photos), who runs it,
 * and a pointer to the school's official clubs page.
 *
 * NO GUARD, BY DESIGN. This page is public. It reads through supabaseAdmin,
 * so THE SELECT LISTS BELOW ARE THE PRIVACY BOUNDARY — they may name only:
 *   events   → id, title, start_time, category, recap   (never created_by)
 *   photos   → storage_path, caption, event_id
 *   profiles → name, role, bio — officers only (role in admin/treasurer,
 *              status approved). Never email, never member rows, never
 *              counts of members, never attendance.
 * events.id is selected ONLY to join photos to their event server-side; no
 * id of any kind is ever rendered into the DOM.
 *
 * FAIL-SOFT, BY DESIGN (deploy-order constraint): the bio/recap columns and
 * the photos table are applied to the database BY HAND, possibly after this
 * code deploys. Every read of them tolerates "column/relation does not
 * exist" by retrying without the new column (or dropping the section) and
 * rendering that section empty — never a 500. This is public-content
 * rendering, not auth; auth elsewhere still fails closed.
 *
 * DESIGN — BOLD GRAPHIC v2. Still deliberately NOT the portal's Warm system:
 * three inks (near-black, vegas gold, one signal red), zero border-radius,
 * full-bleed bands instead of cards, heavy condensed uppercase display type,
 * serif for reading text, dark mode = same gold band with black type rather
 * than inversion. v2 turns the poster into a full experience:
 *   · 100svh masthead — viewport-scale title, the middle line set as a gold
 *     OUTLINE (fills on hover), live San Jose clock, a slowly rotating seal,
 *     and the tape promoted to a solid gold band at the fold.
 *   · "Sec. 00 — The pitch": a manifesto whose lines arrive as outlines and
 *     FILL with ink as they enter; the last line wipes in as a gold-on-black
 *     slab.
 *   · Every photo renders as a GOLD DUOTONE (grayscale + gold multiply), so
 *     any phone photo lands on-palette; hover/focus restores full color —
 *     the record, in living color.
 *   · Unattached photos become a full-bleed horizontal rail (scroll-snap).
 *   · A signal-red scroll progress hair, a square cursor follower in
 *     difference blend, magnetic primary buttons, and a giant cropped
 *     outline wordmark bleeding off the footer.
 * Standalone: no DashboardLayout, no global.css; everything it needs is in
 * this file.
 *
 * MOTION: CSS + one small inline vanilla script, no libraries. Every
 * hidden-until-revealed style is TRIPLE-GATED behind `html.js` (added by an
 * inline head script) AND `prefers-reduced-motion: no-preference` AND
 * `screen` — with JS off or reduced motion on the page is simply static and
 * fully visible, and print always gets every section, revealed or not.
 * Scroll-driven extras (progress hair, hero drift, wordmark rise) sit behind
 * @supports (animation-timeline) and degrade to static. Cursor + magnetism
 * additionally require (pointer:fine). Transform/opacity/filter only; the
 * perpetual loops are the masthead tape and the rotating seal.
 */
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/libre-baskerville/latin-400.css';
import '@fontsource/libre-baskerville/latin-400-italic.css';
import '@fontsource/libre-baskerville/latin-700.css';
/* Hashed URLs for the two above-the-fold faces, preloaded in <head> so a slow
   connection never rebuilds the masthead in Arial Narrow mid-choreography.
   Vite content-hashes assets, so these dedupe to the exact URLs the
   @fontsource CSS above already references. */
import barlowDisplayWoff2 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
import baskervilleWoff2 from '@fontsource/libre-baskerville/files/libre-baskerville-latin-400-normal.woff2?url';
import { supabaseAdmin } from '../lib/supabase';
import { PUBLIC_SUPABASE_URL } from '../lib/env';

/* Public page, no session, no Set-Cookie: safe to let the CDN carry it. */
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600'
);

interface PastEventRow {
  id: string;
  title: string;
  start_time: string;
  category: string | null;
  recap: string | null;
}
interface PhotoRow {
  storage_path: string;
  caption: string | null;
  event_id: string | null;
}
interface OfficerRow {
  name: string | null;
  role: string;
  bio: string | null;
}

const nowIso = new Date().toISOString();

/** Past non-cancelled events, newest first — 'completed' is a legitimate past
 *  state alongside 'active' (attendance.astro counts both the same way).
 *  `recap` fails soft to null pre-migration. */
async function loadPastEvents(): Promise<PastEventRow[]> {
  const res = await supabaseAdmin
    .from('events')
    .select('id, title, start_time, category, recap')
    .in('status', ['active', 'completed'])
    .lt('start_time', nowIso)
    .order('start_time', { ascending: false })
    .limit(24);
  if (!res.error) return (res.data ?? []) as PastEventRow[];

  // Most likely the recap column doesn't exist yet (STEP 17 not run).
  console.error('[pages/about] events+recap query failed; retrying without recap', {
    code: res.error.code,
    message: res.error.message,
  });
  const retry = await supabaseAdmin
    .from('events')
    .select('id, title, start_time, category')
    .in('status', ['active', 'completed'])
    .lt('start_time', nowIso)
    .order('start_time', { ascending: false })
    .limit(24);
  if (retry.error) {
    console.error('[pages/about] events query failed; rendering the section empty', {
      code: retry.error.code,
      message: retry.error.message,
    });
    return [];
  }
  return ((retry.data ?? []) as Omit<PastEventRow, 'recap'>[]).map((e) => ({
    ...e,
    recap: null,
  }));
}

/** Total past non-cancelled events — the section's poster numeral. null on failure. */
async function loadHeldCount(): Promise<number | null> {
  const res = await supabaseAdmin
    .from('events')
    .select('id', { count: 'exact', head: true })
    .in('status', ['active', 'completed'])
    .lt('start_time', nowIso);
  if (res.error) {
    console.error('[pages/about] events count failed', {
      code: res.error.code,
      message: res.error.message,
    });
    return null;
  }
  return res.count;
}

/** Photos, newest first. The table may not exist yet (STEP 18) — fail soft. */
async function loadPhotos(): Promise<PhotoRow[]> {
  const res = await supabaseAdmin
    .from('photos')
    .select('storage_path, caption, event_id')
    .order('created_at', { ascending: false })
    .limit(80);
  if (res.error) {
    console.error('[pages/about] photos query failed (table may not exist yet); rendering none', {
      code: res.error.code,
      message: res.error.message,
    });
    return [];
  }
  return (res.data ?? []) as PhotoRow[];
}

/** Approved officers only. `bio` fails soft to null pre-migration. */
async function loadOfficers(): Promise<OfficerRow[]> {
  const res = await supabaseAdmin
    .from('profiles')
    .select('name, role, bio')
    .eq('status', 'approved')
    .in('role', ['admin', 'treasurer'])
    .order('role', { ascending: true }) // 'admin' sorts before 'treasurer'
    .order('name', { ascending: true });
  if (!res.error) return (res.data ?? []) as OfficerRow[];

  console.error('[pages/about] profiles+bio query failed; retrying without bio', {
    code: res.error.code,
    message: res.error.message,
  });
  const retry = await supabaseAdmin
    .from('profiles')
    .select('name, role')
    .eq('status', 'approved')
    .in('role', ['admin', 'treasurer'])
    .order('role', { ascending: true })
    .order('name', { ascending: true });
  if (retry.error) {
    console.error('[pages/about] profiles query failed; rendering the section empty', {
      code: retry.error.code,
      message: retry.error.message,
    });
    return [];
  }
  return ((retry.data ?? []) as Omit<OfficerRow, 'bio'>[]).map((o) => ({ ...o, bio: null }));
}

const [pastEvents, heldCountRaw, photos, officers] = await Promise.all([
  loadPastEvents(),
  loadHeldCount(),
  loadPhotos(),
  loadOfficers(),
]);
const heldCount = heldCountRaw ?? pastEvents.length;

/* ── Presentation ──────────────────────────────────────────────────────── */

const hasText = (s: string | null | undefined): s is string => (s ?? '').trim() !== '';

/** Plain text → paragraphs. Newlines are the officer's paragraph breaks. */
const paras = (text: string): string[] =>
  text
    .split(/\r?\n+/)
    .map((p) => p.trim())
    .filter((p) => p !== '');

/* Recapped events lead the broadsheet; the rest follow, reverse-chron. */
const recapped = pastEvents.filter((e) => hasText(e.recap));
const brief = pastEvents.filter((e) => !hasText(e.recap));
const shown = [...recapped, ...brief].slice(0, 12);
const shownRecapped = shown.filter((e) => hasText(e.recap));
const shownBrief = shown.filter((e) => !hasText(e.recap));

/* Photos join to the events on display; photos of cancelled / future /
   not-shown events are dropped (the backend allows attaching to cancelled
   past events — this is where that gets filtered). Unattached photos get
   the manifesto slot + the archive rail. */
const shownIds = new Set(shown.map((e) => e.id));
const photosByEvent = new Map<string, PhotoRow[]>();
const unattached: PhotoRow[] = [];
for (const p of photos) {
  if (!hasText(p.storage_path)) continue;
  if (p.event_id === null) {
    unattached.push(p);
    continue;
  }
  if (!shownIds.has(p.event_id)) continue;
  const list = photosByEvent.get(p.event_id) ?? [];
  list.push(p);
  photosByEvent.set(p.event_id, list);
}

/* The newest unattached photo becomes the manifesto's duotone plate; the
   rest run in the full-bleed archive rail. Zero photos → both slots vanish. */
const manifestoShot: PhotoRow | null = unattached[0] ?? null;
const railPhotos = unattached.slice(1);

/* Poster stats. Never member counts — events, photos and officers only. */
const photosCount = photos.filter((p) => hasText(p.storage_path)).length;
const officersCount = officers.length;

/* storage_path is server-generated (photos/<uuid>.<ext>) but treated as
   data: segment-encoded, and only ever emitted into a src attribute. */
const photoUrl = (storagePath: string): string =>
  `${PUBLIC_SUPABASE_URL}/storage/v1/object/public/club-photos/${storagePath
    .split('/')
    .map(encodeURIComponent)
    .join('/')}`;

/* ── Pacific-local dates (club time; the server runs in UTC) ───────────── */
const TZ = 'America/Los_Angeles';
const fmt = (iso: string, opts: Intl.DateTimeFormatOptions): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return new Intl.DateTimeFormat('en-US', { timeZone: TZ, ...opts }).format(d);
};

const now = new Date();
const pacMonth = Number(
  new Intl.DateTimeFormat('en-US', { timeZone: TZ, month: 'numeric' }).format(now)
);
const pacYear = new Intl.DateTimeFormat('en-US', { timeZone: TZ, year: 'numeric' }).format(now);
const season =
  pacMonth >= 8 ? 'Fall' : pacMonth >= 6 ? 'Summer' : pacMonth >= 3 ? 'Spring' : 'Winter';
const seasonLabel = `${season} ${pacYear}`;

const catLabel = (c: string | null): string => {
  const t = (c ?? '').trim() || 'meeting';
  return t.charAt(0).toUpperCase() + t.slice(1);
};

const roleLabel = (role: string): string =>
  role === 'admin' ? 'Admin' : role === 'treasurer' ? 'Treasurer' : 'Officer';

const initialsOf = (name: string | null): string => {
  const parts = (name ?? '').trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return 'MB';
  const first = parts[0].charAt(0);
  const last = parts.length > 1 ? parts[parts.length - 1].charAt(0) : '';
  return (first + last).toUpperCase() || 'MB';
};

const idx2 = (i: number): string => String(i + 1).padStart(2, '0');

const numeral = String(heldCount).padStart(2, '0');

/* The masthead tape — the page's one ambient loop. Repeated so each half of
   the track is wider than any viewport; the CSS loops it seamlessly. */
const tapeUnit = `Mitty Business Club ✱ Archbishop Mitty High School ✱ San Jose, California ✱ ${seasonLabel} ✱ `;
const tape = tapeUnit.repeat(4);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <!-- Browser chrome joins the masthead plane — the poster runs edge to edge. -->
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#0A0A0A" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
  <meta
    name="description"
    content="What the Mitty Business Club has done and who runs it — the student business club at Archbishop Mitty High School, San Jose."
  />
  <title>Mitty Business Club — What we do</title>
  <link rel="preload" as="font" type="font/woff2" href={barlowDisplayWoff2} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={baskervilleWoff2} crossorigin />
  <!-- Motion gate: hidden-until-revealed styles apply ONLY under html.js.
       With scripts off this never runs and every section renders visible. -->
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>

  <!-- Signal-red reading progress hair. Pure CSS scroll-timeline; hidden
       where unsupported, in print, and under reduced motion. -->
  <div class="prog" aria-hidden="true"></div>

  <!-- Square cursor follower (dot + ring, difference blend). Display is
       gated to html.js + pointer:fine + motion-OK; JS drives transforms. -->
  <div class="cur curd" aria-hidden="true"></div>
  <div class="cur curr" aria-hidden="true"></div>

  <!-- ── MASTHEAD — the full-viewport poster ──────────────────────────── -->
  <header class="mast">
    <div class="wrap topline r r1">
      <svg class="crown" viewBox="0 0 64 64" aria-hidden="true"><path d="M6 46V16l14 12L32 8l12 20 14-12v30Z" fill="currentColor"/><rect x="6" y="51" width="52" height="7" fill="currentColor"/></svg>
      <span class="lab schooltop">Student club</span>
      <span class="micro clockw" data-clock aria-hidden="true">San Jose, California</span>
      <a class="btn gold signin" href="/login" data-mag>Member sign in</a>
    </div>

    <div class="titlewrap">
      <p class="lab school r r2">Archbishop Mitty High School &nbsp;·&nbsp; San Jose, California</p>
      <h1 class="dsp title">
        <span class="tl"><span class="tw">Mitty</span></span>
        <span class="tl"><span class="tw o">Business</span></span>
        <span class="tl"><span class="tw">Club<span class="dot" aria-hidden="true"></span></span></span>
      </h1>
    </div>

    <div class="wrap mastfoot r r3">
      <p class="stand">
        The student-run business club at Archbishop Mitty. This page is the record —
        what we&rsquo;ve done, and who we are.
      </p>
      <div class="seal" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs>
            <path id="sealpath" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0" fill="none"/>
          </defs>
          <g class="sealtxt">
            <text textLength="292" lengthAdjust="spacingAndGlyphs">
              <textPath href="#sealpath">MITTY BUSINESS CLUB ✱ SAN JOSE ✱ THE RECORD ✱ </textPath>
            </text>
          </g>
          <path class="sealarw" d="M60 46v24m0 0-8-8m8 8 8-8"/>
        </svg>
      </div>
    </div>

    <div class="marq r r4" aria-hidden="true">
      <div class="tape">
        <span class="lab">{tape}</span>
        <span class="lab">{tape}</span>
      </div>
    </div>
  </header>

  <main>

    <!-- ── SEC. 00 — THE PITCH ─────────────────────────────────────────── -->
    <section class="pitch" aria-labelledby="pitch-h">
      <div class="wrap">
        <div class="kickrow io">
          <span class="micro">Sec. 00 &nbsp;·&nbsp; The pitch</span>
          <svg class="reg" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="5.5"/><path d="M10 1v18M1 10h18"/></svg>
        </div>
        <h2 class="dsp mstat" id="pitch-h">
          <span class="ml io">No hype.</span>
          <span class="ml io">No highlight reel.</span>
          <span class="ml m3 io"><span class="mslab">Just the record.</span></span>
        </h2>
        <div class="pitchrow">
          <p class="serifnote pnote io">
            Every event on this page actually happened — dated, filed, and written
            up by the officers who ran it. If it&rsquo;s not on the record, we
            didn&rsquo;t do it. That&rsquo;s the whole pitch.
          </p>
          {manifestoShot && (
            <figure class="mph io">
              <div class="ph">
                <img
                  src={photoUrl(manifestoShot.storage_path)}
                  alt={manifestoShot.caption ?? ''}
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="600"
                />
              </div>
              {hasText(manifestoShot.caption) && (
                <figcaption class="micro mcap">{manifestoShot.caption}</figcaption>
              )}
            </figure>
          )}
        </div>
      </div>
    </section>

    <!-- ── SEC. 01 — WHAT WE'VE DONE ───────────────────────────────────── -->
    <section class="block" aria-labelledby="done-h">

      <div class="band">
        <div class="strip"><div class="wrap stripline io">
          <span class="micro">Sec. 01 &nbsp;·&nbsp; The record &nbsp;·&nbsp; {seasonLabel}</span>
          <svg class="reg" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="5.5"/><path d="M10 1v18M1 10h18"/></svg>
        </div></div>
        <div class="inner"><div class="wrap">
          <div class="lockup io">
            <span class="hero-num" aria-hidden="true"><span class="hn" data-n={heldCount}>{numeral}</span></span>
            <div class="rest">
              <h2 class="dsp" id="done-h">What we&rsquo;ve done</h2>
              <p class="micro sub2">
                {shown.length === 0
                  ? 'The record opens with our first event'
                  : `${heldCount} ${heldCount === 1 ? 'event' : 'events'} held so far`}
              </p>
            </div>
          </div>
        </div></div>
        <div class="strip top"><div class="wrap statline io">
          <span class="micro">{heldCount} {heldCount === 1 ? 'event' : 'events'} on the record</span>
          {photosCount > 0 && (
            <span class="micro"><span class="sep" aria-hidden="true">✱&nbsp;&nbsp;</span>{photosCount} {photosCount === 1 ? 'photo' : 'photos'} in the archive</span>
          )}
          {officersCount > 0 && (
            <span class="micro"><span class="sep" aria-hidden="true">✱&nbsp;&nbsp;</span>{officersCount} {officersCount === 1 ? 'officer' : 'officers'} at the desk</span>
          )}
        </div></div>
      </div>

      {shown.length === 0 && (
        <div class="wrap zero">
          <p class="dsp zero-l io">Season one</p>
          <p class="dsp zero-l io"><span class="zero-inv">Starts now</span><span class="zstar" aria-hidden="true">✱</span></p>
          <p class="serifnote zeronote io">
            Nothing on the record yet — our first meetings are coming. Check back
            after the first event, and the story starts here.
          </p>
        </div>
      )}

      {shownRecapped.length > 0 && (
        <div class="wrap feed">
          {shownRecapped.map((e, i) => {
            const eventPhotos = photosByEvent.get(e.id) ?? [];
            return (
              <article class="post io">
                <div class="date">
                  <div class="d">{fmt(e.start_time, { day: '2-digit' })}</div>
                  <div class="m micro">
                    {fmt(e.start_time, { month: 'short', year: 'numeric' })}<br />
                    {fmt(e.start_time, { weekday: 'long' })}
                  </div>
                  <div class="pidx micro" aria-hidden="true">№&nbsp;{idx2(i)}</div>
                </div>
                <div class="art">
                  <span class="chip">{catLabel(e.category)}</span>
                  <h3 class="dsp">{e.title}</h3>
                  <div class="prose">
                    {paras(e.recap ?? '').map((p) => <p>{p}</p>)}
                  </div>
                  {eventPhotos.length > 0 && (
                    <div class="shots" role="group" aria-label={`Photos from ${e.title}`}>
                      {eventPhotos.map((p) => (
                        <div class="ph">
                          <img
                            src={photoUrl(p.storage_path)}
                            alt={p.caption ?? ''}
                            loading="lazy"
                            decoding="async"
                            width="800"
                            height="600"
                          />
                          {hasText(p.caption) && <span class="cap micro" aria-hidden="true">{p.caption}</span>}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )}

      <!-- Below: when NO recap exists yet (the launch-week page), the zero
           state's "Season one" lockup stays, scaled down, above the rows —
           the page must not get WORSE the moment the club starts succeeding. -->
      {shownBrief.length > 0 && (
        <div class="wrap">
          {shownRecapped.length > 0 ? (
            <p class="lab alsoh">More from the season</p>
          ) : (
            <div class="opener io">
              <p class="dsp open-l"><span class="zero-inv">Season one</span><span class="zstar" aria-hidden="true">✱</span></p>
              <p class="serifnote opennote">
                The record is open — {heldCount === 1
                  ? 'the first event is in the book'
                  : 'the first events are in the book'}, and the write-ups are
                on their way. The story starts here.
              </p>
            </div>
          )}
          <div class="rows">
            {shownBrief.map((e) => (
              <div class="brief io">
                <span class="dnum" aria-hidden="true">
                  {fmt(e.start_time, { day: '2-digit' })}
                  <small>{fmt(e.start_time, { month: 'short' })}</small>
                </span>
                <span class="ttl">
                  <span class="dsp t">{e.title}</span>
                  <span class="l">
                    {catLabel(e.category)} &nbsp;·&nbsp; {fmt(e.start_time, { month: 'long', day: 'numeric', year: 'numeric' })}
                  </span>
                </span>
                <span class="arw" aria-hidden="true">→</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {railPhotos.length > 0 && (
        <div class="life io">
          <div class="wrap"><p class="lab alsoh">Around the club &nbsp;·&nbsp; drag sideways</p></div>
          <div class="bleed">
            <div class="rail" tabindex="0" role="region" aria-label="Photo archive — scrolls sideways">
              {railPhotos.map((p) => (
                <div class="ph">
                  <img
                    src={photoUrl(p.storage_path)}
                    alt={p.caption ?? ''}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="600"
                  />
                  {hasText(p.caption) && <span class="cap micro" aria-hidden="true">{p.caption}</span>}
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

    </section>

    <!-- ── SEC. 02 — ABOUT US ──────────────────────────────────────────── -->
    <section class="block who" aria-labelledby="who-h">
      <div class="wrap">
        <header class="sechead io">
          <span class="tick" aria-hidden="true"></span>
          <p class="lab kick">Sec. 02 &nbsp;·&nbsp; About us &nbsp;·&nbsp; The officers</p>
          <h2 class="dsp" id="who-h">Who we are</h2>
        </header>

        {officers.length === 0 ? (
          <div class="state io">
            <span class="tick" aria-hidden="true"></span>
            <p class="dsp state-h">Officer profiles are coming.</p>
            <p class="serifnote">Check back soon to meet the team that runs the club.</p>
          </div>
        ) : (
          <ul class="officers">
            {officers.map((o, i) => (
              <li class="off io">
                <p class="micro oix" aria-hidden="true">№&nbsp;{idx2(i)}</p>
                <div class="offhead">
                  <span class="ini2" aria-hidden="true">{initialsOf(o.name)}</span>
                  <div class="offid">
