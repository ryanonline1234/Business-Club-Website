  font-family:var(--editorial);font-size:1.0625rem;line-height:1.65;
  max-width:64ch;margin:0 0 14px;
}
.prose p:last-child{margin-bottom:0}
/* Broadsheet drop cap on the opening paragraph. */
.prose > p:first-child::first-letter{
  font-family:var(--editorial);font-weight:700;
  font-size:3.1em;line-height:.78;
  float:left;padding:.08em .12em 0 0;
}

/* ---------- PHOTOS — the gold duotone plate ----------
   Every photo prints in the club's inks: grayscale under a gold multiply.
   Hover / keyboard focus lifts the plate to full color. Print gets color. */
.ph{position:relative;overflow:hidden;background:var(--black);isolation:isolate}
.ph img{
  width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;
  filter:grayscale(1) contrast(1.06) brightness(.92);
}
.ph::after{
  content:"";position:absolute;inset:0;z-index:1;
  background:var(--gold);mix-blend-mode:multiply;opacity:.85;
  pointer-events:none;
}
.ph .cap{
  position:absolute;left:0;bottom:0;z-index:2;max-width:92%;
  background:var(--black);color:var(--gold);
  padding:6px 10px 5px;
}
.ph:hover img,.ph:focus-visible img{filter:none;transform:scale(1.03)}
.ph:hover::after,.ph:focus-visible::after{opacity:0}

/* Photo strip inside an article: images butted together on a black plane.
   Fixed aspect so nothing reflows while they load. */
.shots{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:3px;padding:3px;background:var(--black);
  margin-top:18px;
}

@media (max-width:640px){
  .post{flex-direction:column;gap:12px}
  .post .date{width:auto;display:flex;align-items:baseline;gap:10px}
  .post .date .m br{display:none}
  .post .date .pidx{margin-top:0;margin-left:auto}
}

