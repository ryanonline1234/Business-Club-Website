     4. school kicker + foot row    480/560ms
     5. tape fades in               640ms, then loops ambiently
     The script holds the first scroll reveals ~700ms when the page opens
     at the top, so nothing below competes with this. */
  html.js .r{opacity:0;animation:fadeup var(--t-reveal) var(--ease-out) forwards}
  html.js .r1{animation-delay:60ms}
  html.js .r2{animation-delay:480ms}
  html.js .r3{animation-delay:560ms}
  html.js .r4{animation-delay:640ms}
  html.js .tw{transform:translateY(108%);animation:rise var(--t-rise) var(--ease-rise) forwards}
  html.js .tl:nth-of-type(1) .tw{animation-delay:120ms}
  html.js .tl:nth-of-type(2) .tw{animation-delay:210ms}
  html.js .tl:nth-of-type(3) .tw{animation-delay:300ms}
  html.js .dot{transform:scale(0);animation:pop var(--t-soft) var(--ease-out) 780ms forwards}

  /* The perpetual loops. Linear is correct for a constant-speed tape;
     the seal turns once every 28 seconds. */
  .tape{animation:marq 38s linear infinite}
  .sealtxt{animation:spin 28s linear infinite}

  /* Scroll entrances: fade-up, 500ms decelerate / 650ms settle. The 60ms
     stagger is assigned PER IO BATCH by the script — whatever reveals
     together staggers together; an item arriving alone starts instantly. */
  html.js .io{
    opacity:0;transform:translateY(16px);
    transition:opacity var(--t-reveal) var(--ease-out),transform var(--t-rise) var(--ease-rise);
  }
  /* …except the brief rows, which arrive along their READING axis — the
     row's hover glide, spoken at entrance scale. (Before .in so the
     settled state still wins.) */
  html.js .brief.io{transform:translateX(-18px)}
  html.js .io.in{opacity:1;transform:none}

  /* Red ticks wipe in with their section — punctuation in motion. */
