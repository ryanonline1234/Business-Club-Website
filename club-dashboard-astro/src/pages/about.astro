---
/**
 * /about — the PUBLIC showcase page. The one page you'd show a student who
 * has never joined: what the club has done (recaps + photos), who runs it,
 * and a pointer to the school's official clubs page.
 *
 * NO GUARD, BY DESIGN. This page is public. It reads through supabaseAdmin,
 * so THE SELECT LISTS BELOW ARE THE PRIVACY BOUNDARY — they may name only:
 *   events   → id, title, start_time, category, recap   (never created_by)
 *   photos   → storage_path, caption, event_id
 *   profiles → name, role, bio — officers only (role in admin/treasurer,
 *              status approved). Never email, never member rows, never
 *              counts of members, never attendance.
 * events.id is selected ONLY to join photos to their event server-side; no
 * id of any kind is ever rendered into the DOM.
 *
 * FAIL-SOFT, BY DESIGN (deploy-order constraint): the bio/recap columns and
 * the photos table are applied to the database BY HAND, possibly after this
 * code deploys. Every read of them tolerates "column/relation does not
 * exist" by retrying without the new column (or dropping the section) and
 * rendering that section empty — never a 500. This is public-content
 * rendering, not auth; auth elsewhere still fails closed.
 *
 * DESIGN: deliberately NOT the portal's Warm system. This is the club's
 * Bold Graphic poster voice — three inks (near-black, vegas gold, one
 * signal red), zero border-radius, full-bleed bands instead of cards,
 * heavy condensed uppercase display type, serif for reading text, dark
 * mode = same gold band with black type rather than inversion. Standalone:
 * no DashboardLayout, no global.css; everything it needs is in this file.
 */
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/libre-baskerville/latin-400.css';
import '@fontsource/libre-baskerville/latin-700.css';
import { supabaseAdmin } from '../lib/supabase';
import { PUBLIC_SUPABASE_URL } from '../lib/env';

/* Public page, no session, no Set-Cookie: safe to let the CDN carry it. */
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600'
);

interface PastEventRow {
  id: string;
  title: string;
  start_time: string;
  category: string | null;
  recap: string | null;
}
interface PhotoRow {
  storage_path: string;
  caption: string | null;
  event_id: string | null;
}
interface OfficerRow {
  name: string | null;
  role: string;
  bio: string | null;
}

const nowIso = new Date().toISOString();

/** Past non-cancelled events, newest first — 'completed' is a legitimate past
 *  state alongside 'active' (attendance.astro counts both the same way).
 *  `recap` fails soft to null pre-migration. */
async function loadPastEvents(): Promise<PastEventRow[]> {
  const res = await supabaseAdmin
    .from('events')
    .select('id, title, start_time, category, recap')
    .in('status', ['active', 'completed'])
    .lt('start_time', nowIso)
    .order('start_time', { ascending: false })
    .limit(24);
  if (!res.error) return (res.data ?? []) as PastEventRow[];

  // Most likely the recap column doesn't exist yet (STEP 17 not run).
  console.error('[pages/about] events+recap query failed; retrying without recap', {
    code: res.error.code,
    message: res.error.message,
  });
  const retry = await supabaseAdmin
    .from('events')
    .select('id, title, start_time, category')
    .in('status', ['active', 'completed'])
    .lt('start_time', nowIso)
    .order('start_time', { ascending: false })
    .limit(24);
  if (retry.error) {
    console.error('[pages/about] events query failed; rendering the section empty', {
      code: retry.error.code,
      message: retry.error.message,
    });
    return [];
  }
  return ((retry.data ?? []) as Omit<PastEventRow, 'recap'>[]).map((e) => ({
    ...e,
    recap: null,
  }));
}

/** Total past non-cancelled events — the section's poster numeral. null on failure. */
async function loadHeldCount(): Promise<number | null> {
  const res = await supabaseAdmin
    .from('events')
    .select('id', { count: 'exact', head: true })
    .in('status', ['active', 'completed'])
    .lt('start_time', nowIso);
  if (res.error) {
    console.error('[pages/about] events count failed', {
      code: res.error.code,
      message: res.error.message,
    });
    return null;
  }
  return res.count;
}

/** Photos, newest first. The table may not exist yet (STEP 18) — fail soft. */
async function loadPhotos(): Promise<PhotoRow[]> {
  const res = await supabaseAdmin
    .from('photos')
    .select('storage_path, caption, event_id')
    .order('created_at', { ascending: false })
    .limit(80);
  if (res.error) {
    console.error('[pages/about] photos query failed (table may not exist yet); rendering none', {
      code: res.error.code,
      message: res.error.message,
    });
    return [];
  }
  return (res.data ?? []) as PhotoRow[];
}

/** Approved officers only. `bio` fails soft to null pre-migration. */
async function loadOfficers(): Promise<OfficerRow[]> {
  const res = await supabaseAdmin
    .from('profiles')
    .select('name, role, bio')
    .eq('status', 'approved')
    .in('role', ['admin', 'treasurer'])
    .order('role', { ascending: true }) // 'admin' sorts before 'treasurer'
    .order('name', { ascending: true });
  if (!res.error) return (res.data ?? []) as OfficerRow[];

  console.error('[pages/about] profiles+bio query failed; retrying without bio', {
    code: res.error.code,
    message: res.error.message,
  });
  const retry = await supabaseAdmin
    .from('profiles')
    .select('name, role')
    .eq('status', 'approved')
    .in('role', ['admin', 'treasurer'])
    .order('role', { ascending: true })
    .order('name', { ascending: true });
  if (retry.error) {
    console.error('[pages/about] profiles query failed; rendering the section empty', {
      code: retry.error.code,
      message: retry.error.message,
    });
    return [];
  }
  return ((retry.data ?? []) as Omit<OfficerRow, 'bio'>[]).map((o) => ({ ...o, bio: null }));
}

const [pastEvents, heldCountRaw, photos, officers] = await Promise.all([
  loadPastEvents(),
  loadHeldCount(),
  loadPhotos(),
  loadOfficers(),
]);
const heldCount = heldCountRaw ?? pastEvents.length;

/* ── Presentation ──────────────────────────────────────────────────────── */

const hasText = (s: string | null | undefined): s is string => (s ?? '').trim() !== '';

/** Plain text → paragraphs. Newlines are the officer's paragraph breaks. */
const paras = (text: string): string[] =>
  text
    .split(/\r?\n+/)
    .map((p) => p.trim())
    .filter((p) => p !== '');

/* Recapped events lead the broadsheet; the rest follow, reverse-chron. */
const recapped = pastEvents.filter((e) => hasText(e.recap));
const brief = pastEvents.filter((e) => !hasText(e.recap));
const shown = [...recapped, ...brief].slice(0, 12);
const shownRecapped = shown.filter((e) => hasText(e.recap));
const shownBrief = shown.filter((e) => !hasText(e.recap));

/* Photos join to the events on display; photos of cancelled / future /
   not-shown events are dropped (the backend allows attaching to cancelled
   past events — this is where that gets filtered). Unattached photos get
   their own grid. */
const shownIds = new Set(shown.map((e) => e.id));
const photosByEvent = new Map<string, PhotoRow[]>();
const unattached: PhotoRow[] = [];
for (const p of photos) {
  if (!hasText(p.storage_path)) continue;
  if (p.event_id === null) {
    unattached.push(p);
    continue;
  }
  if (!shownIds.has(p.event_id)) continue;
  const list = photosByEvent.get(p.event_id) ?? [];
  list.push(p);
  photosByEvent.set(p.event_id, list);
}

/* storage_path is server-generated (photos/<uuid>.<ext>) but treated as
   data: segment-encoded, and only ever emitted into a src attribute. */
const photoUrl = (storagePath: string): string =>
  `${PUBLIC_SUPABASE_URL}/storage/v1/object/public/club-photos/${storagePath
    .split('/')
    .map(encodeURIComponent)
    .join('/')}`;

/* ── Pacific-local dates (club time; the server runs in UTC) ───────────── */
const TZ = 'America/Los_Angeles';
const fmt = (iso: string, opts: Intl.DateTimeFormatOptions): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return new Intl.DateTimeFormat('en-US', { timeZone: TZ, ...opts }).format(d);
};

const now = new Date();
const pacMonth = Number(
  new Intl.DateTimeFormat('en-US', { timeZone: TZ, month: 'numeric' }).format(now)
);
const pacYear = new Intl.DateTimeFormat('en-US', { timeZone: TZ, year: 'numeric' }).format(now);
const season =
  pacMonth >= 8 ? 'Fall' : pacMonth >= 6 ? 'Summer' : pacMonth >= 3 ? 'Spring' : 'Winter';
const seasonLabel = `${season} ${pacYear}`;

const catLabel = (c: string | null): string => {
  const t = (c ?? '').trim() || 'meeting';
  return t.charAt(0).toUpperCase() + t.slice(1);
};

const roleLabel = (role: string): string =>
  role === 'admin' ? 'Admin' : role === 'treasurer' ? 'Treasurer' : 'Officer';

const initialsOf = (name: string | null): string => {
  const parts = (name ?? '').trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return 'MB';
  const first = parts[0].charAt(0);
  const last = parts.length > 1 ? parts[parts.length - 1].charAt(0) : '';
  return (first + last).toUpperCase() || 'MB';
};

const numeral = String(heldCount).padStart(2, '0');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta
    name="description"
    content="What the Mitty Business Club has done and who runs it — the student business club at Archbishop Mitty High School, San Jose."
  />
  <title>Mitty Business Club — What we do</title>
</head>
<body>

  <!-- ── MASTHEAD ──────────────────────────────────────────────────────── -->
  <header class="mast">
    <div class="wrap">
      <div class="topline">
        <svg class="crown" viewBox="0 0 64 64" aria-hidden="true"><path d="M6 46V16l14 12L32 8l12 20 14-12v30Z" fill="currentColor"/><rect x="6" y="51" width="52" height="7" fill="currentColor"/></svg>
        <span class="lab schooltop">Student club</span>
        <a class="btn gold signin" href="/login">Member sign in</a>
      </div>
      <h1 class="dsp title">Mitty<br />Business<br />Club</h1>
      <p class="lab school">Archbishop Mitty High School &nbsp;·&nbsp; San Jose, California</p>
      <p class="stand">
        The student-run business club at Archbishop Mitty. This page is the record —
        what we've done, and who we are.
      </p>
    </div>
  </header>

  <main>

    <!-- ── WHAT WE'VE DONE ─────────────────────────────────────────────── -->
    <section class="block" aria-labelledby="done-h">

      <div class="band">
        <div class="strip"><div class="wrap"><span class="micro">The record &nbsp;·&nbsp; {seasonLabel}</span></div></div>
        <div class="inner"><div class="wrap">
          <div class="lockup">
            <span class="hero-num" aria-hidden="true">{numeral}</span>
            <div class="rest">
              <h2 class="dsp" id="done-h">What we've done</h2>
              <p class="micro sub2">
                {shown.length === 0
                  ? 'Season one starts now'
                  : `${heldCount} ${heldCount === 1 ? 'event' : 'events'} held so far`}
              </p>
            </div>
          </div>
          {shown.length === 0 && (
            <p class="bandnote">
              Our first meetings are coming — check back after the first event.
            </p>
          )}
        </div></div>
      </div>

      {shownRecapped.length > 0 && (
        <div class="wrap feed">
          {shownRecapped.map((e) => {
            const eventPhotos = photosByEvent.get(e.id) ?? [];
            return (
              <article class="post">
                <div class="date">
                  <div class="d">{fmt(e.start_time, { day: '2-digit' })}</div>
                  <div class="m micro">
                    {fmt(e.start_time, { month: 'short', year: 'numeric' })}<br />
                    {fmt(e.start_time, { weekday: 'long' })}
                  </div>
                </div>
                <div class="art">
                  <span class="chip">{catLabel(e.category)}</span>
                  <h3 class="dsp">{e.title}</h3>
                  <div class="prose">
                    {paras(e.recap ?? '').map((p) => <p>{p}</p>)}
                  </div>
                  {eventPhotos.length > 0 && (
                    <div class="shots" role="group" aria-label={`Photos from ${e.title}`}>
                      {eventPhotos.map((p) => (
                        <img
                          src={photoUrl(p.storage_path)}
                          alt={p.caption ?? ''}
                          loading="lazy"
                          decoding="async"
                          width="800"
                          height="600"
                        />
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )}

      {shownBrief.length > 0 && (
        <div class="wrap">
          {shownRecapped.length > 0 && <p class="lab alsoh">More from the season</p>}
          <div class="rows">
            {shownBrief.map((e) => (
              <div class="brief">
                <span class="dnum" aria-hidden="true">
                  {fmt(e.start_time, { day: '2-digit' })}
                  <small>{fmt(e.start_time, { month: 'short' })}</small>
                </span>
                <span class="ttl">
                  <span class="dsp t">{e.title}</span>
                  <span class="l">
                    {catLabel(e.category)} &nbsp;·&nbsp; {fmt(e.start_time, { month: 'long', day: 'numeric', year: 'numeric' })}
                  </span>
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      {unattached.length > 0 && (
        <div class="wrap life">
          <p class="lab alsoh">Around the club</p>
          <div class="shots">
            {unattached.map((p) => (
              <img
                src={photoUrl(p.storage_path)}
                alt={p.caption ?? ''}
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            ))}
          </div>
        </div>
      )}

    </section>

    <!-- ── ABOUT US ────────────────────────────────────────────────────── -->
    <section class="block who" aria-labelledby="who-h">
      <div class="wrap">
        <header class="sechead">
          <p class="lab kick">About us &nbsp;·&nbsp; The officers</p>
          <h2 class="dsp" id="who-h">Who we are</h2>
        </header>

        {officers.length === 0 ? (
          <div class="state">
            <p class="dsp state-h">Officer profiles are coming.</p>
            <p class="serifnote">Check back soon to meet the team that runs the club.</p>
          </div>
        ) : (
          <ul class="officers">
            {officers.map((o) => (
              <li class="off">
                <div class="offhead">
                  <span class="ini2" aria-hidden="true">{initialsOf(o.name)}</span>
                  <div class="offid">
                    <p class="dsp nm">{o.name ?? 'Officer'}</p>
                    <span class={o.role === 'admin' ? 'badge admin' : 'badge treas'}>
                      {roleLabel(o.role)}
                    </span>
                  </div>
                </div>
                {hasText(o.bio) && (
                  <div class="bio">
                    {paras(o.bio).map((p) => <p>{p}</p>)}
                  </div>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

  </main>

  <!-- ── FOOTER BAND ───────────────────────────────────────────────────── -->
  <footer class="night">
    <div class="wrap">
      <p class="lab k">Find us</p>
      <h2 class="dsp fh">Come see for yourself.</h2>
      <div class="fx">
        <a
          class="btn gold"
          href="https://www.mitty.com/student-activities/clubs"
          target="_blank"
          rel="noopener"
        >See us on the Mitty club page ↗</a>
        <a class="btn ghost" href="/login">Member sign in</a>
      </div>
      <p class="micro tail">
        Mitty Business Club &nbsp;·&nbsp; Archbishop Mitty High School &nbsp;·&nbsp; San Jose, California
      </p>
    </div>
  </footer>

</body>
</html>

<style is:global>
/* ═══════════════════════════════════════════════════════════════════
   BOLD GRAPHIC — the club's public poster voice.
   Three inks. Zero radius. Type is the layout.
   Scoped to this standalone page; the portal's Warm system is untouched.
   ═══════════════════════════════════════════════════════════════════ */

:root{
  color-scheme:light dark;

  /* THE THREE INKS. gold is a PLANE, never ink on bone (2.02:1) — wherever
     gold meets a light ground it carries a black edge. */
  --gold:#C5B358;
  --gold-deep:#665935;   /* the only gold allowed as text on bone — 6.6:1 */
  --signal:#E2452B;
  --signal-ink:#C2361E;
  --black:#0A0A0A;
  --bone:#FBFAF8;

  /* GROUND — light */
  --ground:#FBFAF8;
  --ground-2:#F0EDE4;
  --text:#16150F;
  --muted:#5B564A;
  --rule:#0A0A0A;
  --rule-soft:#B9B09A;

  /* THE GOLD PLANE — committed in BOTH themes. Black type, nothing else. */
  --band-bg:var(--gold);
  --band-fg:#0A0A0A;
  --band-dim:#3E3616;

  /* THE NIGHT PLANE — the footer. Does not flip either. */
  --night-bg:#0A0A0A;
  --night-fg:#FBFAF8;
  --night-dim:#B9B3A5;

  --goldtext:var(--gold-deep);
  --mast-bg:#0A0A0A;
  --mast-fg:#FBFAF8;
  --mast-dim:#9A9488;

  /* TYPE. Self-hosted via @fontsource; system stacks as fallback. */
  --display:'Barlow Condensed','Arial Narrow','Helvetica Neue',Helvetica,sans-serif;
  --ui:'Helvetica Neue',Helvetica,Arial,'Liberation Sans',sans-serif;
  --editorial:'Libre Baskerville',Georgia,'Palatino Linotype',Palatino,serif;

  /* ONE SCALE — one base, one ratio (1.5). */
  --f-base:clamp(.95rem,.72rem + .98vw,1.35rem);
  --f-h3:calc(var(--f-base) * 1.5);
  --f-h2:calc(var(--f-base) * 2.25);
  --f-h1:calc(var(--f-base) * 3.375);
  --f-num:calc(var(--f-base) * 5.0625);
  --f-mega:calc(var(--f-base) * 7.594);

  /* TWO LABEL TOKENS. There is no third. */
  --lab-size:.6875rem;   --lab-track:.17em;
  --micro-size:.5625rem; --micro-track:.22em;

  /* THREE BORDER WEIGHTS, each with a job. */
  --w-hair:1px;
  --w-sec:3px;
  --w-plane:6px;

  --gut:clamp(16px,4vw,40px);
  --frame:1120px;
}

@media (prefers-color-scheme:dark){
  :root{
    /* Raised off #000 so the black masthead still reads as its own block.
       The gold plane and the night plane do NOT flip — one system, two themes. */
    --ground:#2A2620;
    --ground-2:#332F27;
    --text:#EFEBE1;
    --muted:#A39C8C;
    --rule:#EFEBE1;
    --rule-soft:#6B6353;
    --signal-ink:#FF7F66;
    --goldtext:#D6C87F;
    --mast-bg:#000000;
  }
}

/* ---------- RESET ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;
  background:var(--ground);
  color:var(--text);
  font-family:var(--ui);
  font-size:16px;
  line-height:1.45;
  -webkit-font-smoothing:antialiased;
}
img,svg{display:block;max-width:100%}
a{color:inherit}
h1,h2,h3,p,figure,ul,ol{margin:0}
ul,ol{list-style:none;padding:0}

:focus-visible{outline:3px solid var(--goldtext);outline-offset:2px}
.mast :focus-visible,.band :focus-visible,.night :focus-visible{outline-color:currentColor}

/* ---------- TYPE UTILITIES ---------- */
.dsp{
  font-family:var(--display);
  font-weight:800;
  text-transform:uppercase;
  line-height:.87;
  letter-spacing:.008em;
  font-synthesis-weight:none;
  hyphens:auto;
  overflow-wrap:anywhere;
}
.lab,.micro{font-family:var(--ui);font-weight:800;text-transform:uppercase;line-height:1.3}
.lab{font-size:var(--lab-size);letter-spacing:var(--lab-track)}
.micro{font-size:var(--micro-size);letter-spacing:var(--micro-track)}

.wrap{max-width:var(--frame);margin:0 auto;padding-left:var(--gut);padding-right:var(--gut)}

/* ---------- BUTTONS ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  min-height:48px;padding:13px 20px;border:var(--w-sec) solid var(--rule);
  background:var(--rule);color:var(--ground);
  font-family:var(--ui);font-weight:800;font-size:var(--lab-size);
  letter-spacing:var(--lab-track);text-transform:uppercase;
  cursor:pointer;text-decoration:none;text-align:center;
  transition:transform 90ms ease,background-color 110ms linear,color 110ms linear,border-color 110ms linear;
}
.btn:hover{background:var(--gold);border-color:var(--black);color:var(--black)}
.btn:active{transform:translateY(2px)}
/* gold never floats on a light ground — it always carries a black edge */
.btn.gold{background:var(--gold);border-color:var(--black);color:var(--black)}
.btn.gold:hover{background:var(--bone);border-color:var(--black);color:var(--black)}
.night .btn.ghost{background:transparent;border-color:var(--night-fg);color:var(--night-fg)}
.night .btn.ghost:hover{background:var(--night-fg);color:var(--night-bg)}

/* ---------- MASTHEAD ---------- */
.mast{
  background:var(--mast-bg);color:var(--mast-fg);
  border-bottom:var(--w-plane) solid var(--gold);
  padding:18px 0 clamp(28px,4vw,48px);
}
.topline{
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding-bottom:16px;margin-bottom:clamp(22px,3.5vw,40px);
  border-bottom:var(--w-hair) solid rgba(251,250,248,.28);
}
.crown{width:32px;height:32px;color:var(--gold);flex:none}
.schooltop{color:var(--mast-dim);margin-right:auto}
.title{font-size:clamp(3.2rem,1.4rem + 8.8vw,8.75rem);line-height:.84}
.school{margin-top:18px;color:var(--mast-dim)}
.stand{
  margin-top:16px;
  font-family:var(--editorial);
  font-size:calc(var(--f-base) * 1.02);
  line-height:1.65;
  max-width:44ch;
}

/* ---------- SECTIONS ---------- */
.block{padding:0 0 clamp(44px,7vw,84px)}
.sechead{border-bottom:var(--w-sec) solid var(--rule);padding-bottom:12px}
.sechead .kick{color:var(--muted);margin-bottom:10px}
.sechead h2{font-size:var(--f-h1)}
.who{padding-top:clamp(36px,6vw,64px)}

/* ---------- THE GOLD PLANE ---------- */
.band{
  background:var(--band-bg);color:var(--band-fg);
  border-top:var(--w-sec) solid var(--black);
  border-bottom:var(--w-sec) solid var(--black);
  margin-bottom:clamp(10px,2vw,20px);
}
.band .strip{border-bottom:var(--w-hair) solid currentColor;padding:9px 0}
.band .inner{padding:clamp(22px,3.2vw,40px) 0}
.lockup{display:flex;align-items:flex-end;gap:clamp(14px,2.4vw,26px);flex-wrap:wrap}
.hero-num{
