---
/**
 * /checkin — the public phone page a member lands on after scanning the
 * projected QR code. Deliberately public: the scan happens BEFORE sign-in.
 *
 * Server-side decides which single view renders:
 *   invalid — no token, bad/expired token, missing or non-active event.
 *             Shows NO event details: an invalid token is not permission to
 *             learn what the meeting was.
 *   error   — the event lookup itself failed (transient). No details either.
 *   signin  — valid token but nobody signed in: hand off to Google with a
 *             root-relative ?next= so they land right back here.
 *   pending — signed in but not yet approved by an officer.
 *   already — signed in + approved AND this member already has an attendance
 *             row for this event. Rendered server-side, so reopening or
 *             refreshing the page answers "am I checked in?" with a ✓ instead
 *             of offering a button whose result you only learn by tapping it.
 *             This holds even after the 15-minute code has expired (or the
 *             event stopped being active): the token is re-verified with the
 *             expiry relaxed — signature still enforced — and ONLY to look up
 *             the member's own row. Nothing is written on that path, and
 *             someone with no row still gets the details-free 'invalid' view.
 *   ready   — signed in + approved, not yet checked in: checks in
 *             AUTOMATICALLY on load (owner decision, 2026-09-30 — scan, and
 *             you're in; no tap to forget). Client JS POSTs { qr_token } to
 *             /api/attendance/checkin and swaps to the pre-rendered done /
 *             already panels (textContent only — no HTML is ever built from
 *             response data). A failure reveals a "Try again" button.
 *
 * Auto check-in and link previews: unfurlers (iMessage, Slack) fetch this page
 * WITHOUT the member's cookies and do not run its script, so a preview cannot
 * check anyone in. The session cookie is SameSite=Lax, so a cross-site
 * <iframe> of this page is signed out too. What remains is ANY top-level visit
 * with a live token: a scan, or equally a tap on a forwarded link (Lax cookies
 * ride top-level navigations, and a link tapped in a chat app is
 * indistinguishable from a scan). That is the accepted bearer-token trade in
 * docs/KNOWN-GAPS.md, one tap shorter than before.
 */
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/libre-baskerville/latin-400.css';
import '@fontsource/libre-baskerville/latin-600.css';
import '@fontsource/libre-baskerville/latin-700.css';
import { verifyQRToken } from '../lib/qrcode';
import { getSession } from '../lib/auth';
import { supabaseAdmin } from '../lib/supabase';

/**
 * Charset gate BEFORE anything touches the token. A verifying token is always
 * a jose compact JWS (base64url segments joined by dots), so this rejects
 * nothing legitimate — but it makes the safety of the define:vars inline
 * script below EXPLICIT rather than an implicit consequence of verification:
 * Astro's script-var serializer only escapes the literal `</script>` string,
 * and the HTML tokenizer also closes a script on variants like `</script x>`.
 * With this gate no `<` or `>` can ever reach that script.
 */
const rawToken = Astro.url.searchParams.get('token');
const token = rawToken && /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(rawToken)
  ? rawToken
  : null;
const session = await getSession(Astro.request, Astro.response.headers);

type View = 'invalid' | 'error' | 'signin' | 'pending' | 'already' | 'ready';
let view: View = 'invalid';
let event: {
  id: string;
  title: string;
  start_time: string;
  end_time: string | null;
  location: string | null;
} | null = null;

if (token) {
  const payload = await verifyQRToken(token);
  if (payload) {
    const { data, error } = await supabaseAdmin
      .from('events')
      .select('id, title, start_time, end_time, location, status')
      .eq('id', payload.event_id)
      .maybeSingle();

    if (error) {
      console.error('[checkin] event lookup failed', {
        eventId: payload.event_id,
        message: error.message,
        code: error.code,
      });
      view = 'error';
    } else if (data && data.status === 'active') {
      event = data;
      view = !session ? 'signin' : session.isApproved ? 'ready' : 'pending';
    }
    // data missing or event not active → stays 'invalid'; no details shown.
  }
}

/* Already checked in? Answer it on the server, so the page never shows a
   button to someone who is already in. A failed lookup falls back to 'ready':
   the POST's own duplicate check (409 → the "already" panel) still catches it. */
let alreadyAt: string | null = null;

/* Code expired (or the event is no longer active), but this member already
   used it: still answer "you're in". The token is re-verified with only the
   expiry relaxed, and the lookup is the member's OWN attendance row — nothing
   is written, and anyone without a row keeps the details-free 'invalid' view,
   so an old code is still not permission to learn what the meeting was. */
const STALE_CODE_GRACE_S = 24 * 60 * 60;
if (view === 'invalid' && token && session?.isApproved) {
  const stale = await verifyQRToken(token, { expiredGraceS: STALE_CODE_GRACE_S });
  if (stale) {
    const [evRes, rowRes] = await Promise.all([
      supabaseAdmin
        .from('events')
        .select('id, title, start_time, end_time, location')
        .eq('id', stale.event_id)
        .maybeSingle(),
      supabaseAdmin
        .from('attendance')
        .select('checked_in_at')
        .eq('event_id', stale.event_id)
        .eq('member_id', session.id)
        .maybeSingle(),
    ]);
    if (!evRes.error && !rowRes.error && evRes.data && rowRes.data) {
      event = evRes.data;
      view = 'already';
      alreadyAt = (rowRes.data.checked_in_at as string | null) ?? null;
    }
  }
}

if (view === 'ready' && event && session) {
  const { data: existing, error: existingError } = await supabaseAdmin
    .from('attendance')
    .select('checked_in_at')
    .eq('event_id', event.id)
    .eq('member_id', session.id)
    .maybeSingle();
  if (existingError) {
    console.error('[checkin] existing check-in lookup failed', {
      eventId: event.id,
      message: existingError.message,
      code: existingError.code,
    });
  } else if (existing) {
    view = 'already';
    alreadyAt = (existing.checked_in_at as string | null) ?? null;
  }
}

// When/where line — Pacific-local, .hl only when the event is TODAY.
const TZ = 'America/Los_Angeles';
const dayKey = (value: string | Date): string =>
  new Date(value).toLocaleDateString('en-CA', { timeZone: TZ });
const fmtTime = (value: string): string =>
  new Date(value).toLocaleTimeString('en-US', { timeZone: TZ, hour: 'numeric', minute: '2-digit' });

let whenText = '';
let isToday = false;
if (event) {
  isToday = dayKey(event.start_time) === dayKey(new Date());
  const dayLabel = isToday
    ? 'Today'
    : new Date(event.start_time).toLocaleDateString('en-US', {
        timeZone: TZ,
        weekday: 'short',
        month: 'short',
        day: 'numeric',
      });
  const start = fmtTime(event.start_time);
  const end = event.end_time ? fmtTime(event.end_time) : '';
  whenText = `${dayLabel}, ${start}${end ? ` – ${end}` : ''}`;
}

// Server-rendered times are Pacific (the room is in San Jose); the client
// swaps in the phone's own clock only for a check-in made on this page.
const alreadyTime = alreadyAt ? fmtTime(alreadyAt) : null;

const selfPath = token ? `/checkin?token=${encodeURIComponent(token)}` : '/checkin';
const signinHref = `/api/auth/signin?next=${encodeURIComponent(selfPath)}`;
const firstName = session?.name?.trim().split(/\s+/)[0] || null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="robots" content="noindex" />
  <title>Check in — Mitty Business Club</title>
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <svg width="0" height="0" class="svgdefs" aria-hidden="true" focusable="false">
    <defs>
      <g id="monogram" fill="none">
        <circle cx="20" cy="20" r="18.25" stroke="#8E7B48" stroke-width="1.3"/>
        <path d="M11 27.4h18M11 27.4V14.6l4.6 5.2L20 12l4.4 7.8 4.6-5.2v12.8" stroke="#8E7B48" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="M20 6.4v3.4M18.4 8.1h3.2" stroke="#8E7B48" stroke-width="1.3" stroke-linecap="round"/>
      </g>
    </defs>
  </svg>

  <div class="sheet">
    <div class="pmark">
      <svg width="22" height="22" viewBox="0 0 40 40" aria-hidden="true"><use href="#monogram"/></svg>
      <span>Mitty Business Club</span>
    </div>

    {view === 'invalid' && (
      <div class="pcheck">
        <p class="seal seal--clay" aria-hidden="true">!</p>
        <h1 style="margin-top:16px;">This code isn&rsquo;t valid anymore.</h1>
        <p class="pcheck__meta">
          Ask an officer to put a fresh one up — the projected code refreshes every few
          minutes.
        </p>
        <p class="pcheck__meta">
          Already scanned it? Your check-in is saved — the portal shows your ✓.
        </p>
        <div class="pcheck__spacer"></div>
        <a class="btn btn--ghost btn--wide" href="/">Check my status in the portal</a>
        <p class="pcheck__foot">No event details are shown here on purpose.</p>
      </div>
    )}

    {view === 'error' && (
      <div class="pcheck">
        <p class="seal seal--clay" aria-hidden="true">↻</p>
        <h1 style="margin-top:16px;">Couldn&rsquo;t load this check-in.</h1>
        <p class="pcheck__meta">Something hiccuped on our end. Nothing was recorded.</p>
        <div class="pcheck__spacer"></div>
        <a class="btn btn--ghost btn--wide" href={selfPath}>Try again</a>
        <p class="pcheck__foot">If it keeps happening, tell an officer.</p>
      </div>
    )}

    {view === 'signin' && event && (
      <div class="pcheck">
        <span class="pcheck__kicker">Checking in to</span>
        <h1>{event.title}</h1>
        <p class="pcheck__meta">
          {isToday ? <span class="hl">{whenText}</span> : whenText}
          {event.location && <><br />{event.location}</>}
        </p>
        <div class="pcheck__spacer"></div>
        <a class="btn btn--wide" href={signinHref}>Sign in with your school account</a>
        <p class="pcheck__foot">School Google accounts only. You&rsquo;ll land right back here.</p>
      </div>
    )}

    {view === 'pending' && event && session && (
      <div class="pcheck">
        <span class="pcheck__kicker">Checking in to</span>
        <h1>{event.title}</h1>
        <p class="pcheck__meta">
          {isToday ? <span class="hl">{whenText}</span> : whenText}
          {event.location && <><br />{event.location}</>}
        </p>
        <p class="pcheck__meta">
          Your account isn&rsquo;t active yet, so check-in isn&rsquo;t open to you.
          School accounts normally get in right away &mdash; mention it to a club officer.
        </p>
        <div class="pcheck__spacer"></div>
        <a class="btn btn--ghost btn--wide" href="/pending">See account status</a>
        <div class="pcheck__foot">
          Signed in as {session.email} ·
          <form method="post" action="/api/auth/signout" style="display:inline">
            <button
              type="submit"
              style="background:none;border:0;margin:0;padding:14px 6px;display:inline-block;color:var(--gold-2);font:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px;"
            >Not you?</button>
          </form>
        </div>
      </div>
    )}

    {view === 'already' && event && session && (
      <div class="pcheck">
        <p class="seal" aria-hidden="true">✓</p>
        <h1 style="margin-top:16px;">You&rsquo;re checked in{firstName ? `, ${firstName}` : ''}.</h1>
        <p class="pcheck__meta">
          {alreadyTime
            ? <>Checked in at <span class="hl">{alreadyTime}</span> — {event.title}{event.location ? `, ${event.location}` : ''}.</>
            : <>Your check-in for {event.title} is recorded.</>}
        </p>
        <div class="pcheck__spacer"></div>
        <a class="btn btn--ghost btn--wide" href="/">Back to the portal</a>
        <div class="pcheck__foot">
          Signed in as {session.email} ·
          <form method="post" action="/api/auth/signout" style="display:inline">
            <button
              type="submit"
              style="background:none;border:0;margin:0;padding:14px 6px;display:inline-block;color:var(--gold-2);font:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px;"
            >Not you?</button>
          </form>
        </div>
      </div>
    )}

    {view === 'ready' && event && session && (
      <>
        <div class="pcheck" id="panel-ready">
          <span class="pcheck__kicker">Checking in to</span>
          <h1>{event.title}</h1>
          <p class="pcheck__meta">
            {isToday ? <span class="hl">{whenText}</span> : whenText}
            {event.location && <><br />{event.location}</>}
          </p>
          <div class="pcheck__spacer"></div>
          <p class="pcheck__working" id="checkin-working" role="status">
            <span class="pcheck__dot" aria-hidden="true"></span>Checking you in…
          </p>
          <noscript>
            <style>.pcheck__working{ display:none; }</style>
            <p class="pcheck__meta" style="color:var(--clay);">
              Check-in needs JavaScript. Turn it on, or ask an officer to check you in.
            </p>
          </noscript>
          <p
            class="pcheck__meta"
            id="checkin-error"
            role="alert"
            style="display:none;margin-bottom:12px;color:var(--clay);"
          ></p>
          <button class="btn btn--wide" id="checkin-btn" type="button" style="display:none">Try again</button>
          <div class="pcheck__foot">
            Signed in as {session.email} ·
            <form method="post" action="/api/auth/signout" style="display:inline">
              <button
                type="submit"
                style="background:none;border:0;margin:0;padding:14px 6px;display:inline-block;color:var(--gold-2);font:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px;"
              >Not you?</button>
            </form>
          </div>
        </div>

        <div class="pcheck" id="panel-done" style="display:none">
          <p class="seal" aria-hidden="true">✓</p>
          <h1 style="margin-top:16px;" tabindex="-1">
            You&rsquo;re in{firstName ? `, ${firstName}` : ''}.
          </h1>
          <p class="pcheck__meta">
            Checked in at <span class="hl" id="done-time">just now</span> — {event.title}{event.location ? `, ${event.location}` : ''}.
          </p>
          <div class="pcheck__spacer"></div>
          <a class="btn btn--ghost btn--wide" href="/">Back to the portal</a>
          <div class="pcheck__foot">
            Signed in as {session.email} ·
            <form method="post" action="/api/auth/signout" style="display:inline">
              <button
                type="submit"
                style="background:none;border:0;margin:0;padding:14px 6px;display:inline-block;color:var(--gold-2);font:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px;"
              >Not you?</button>
            </form>
          </div>
        </div>

        <div class="pcheck" id="panel-already" style="display:none">
          <p class="seal" aria-hidden="true">✓</p>
          <h1 style="margin-top:16px;" tabindex="-1">You&rsquo;re already in{firstName ? `, ${firstName}` : ''}.</h1>
          <p class="pcheck__meta">
            Your check-in for {event.title} was already recorded<span id="already-time"></span>. You&rsquo;re all set.
          </p>
          <div class="pcheck__spacer"></div>
          <a class="btn btn--ghost btn--wide" href="/">Back to the portal</a>
          <div class="pcheck__foot">
            Signed in as {session.email} ·
            <form method="post" action="/api/auth/signout" style="display:inline">
              <button
                type="submit"
                style="background:none;border:0;margin:0;padding:14px 6px;display:inline-block;color:var(--gold-2);font:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px;"
              >Not you?</button>
            </form>
          </div>
        </div>
      </>
    )}
  </div>

  {view === 'ready' && (
    <script is:inline define:vars={{ token, signinHref }}>
      var btn = document.getElementById('checkin-btn');
      var working = document.getElementById('checkin-working');
      var err = document.getElementById('checkin-error');
      var panelReady = document.getElementById('panel-ready');
      var panelDone = document.getElementById('panel-done');
      var panelAlready = document.getElementById('panel-already');

      function fmtTime(iso) {
        if (typeof iso !== 'string') return null;
        var d = new Date(iso);
        if (isNaN(d.getTime())) return null;
        // The phone's own timezone — the member is standing in the room.
        return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
      }

      function show(panel) {
        panelReady.style.display = 'none';
        panel.style.display = '';
        var h = panel.querySelector('h1');
        if (h) h.focus();
      }

      function fail(message) {
        working.style.display = 'none';
        err.textContent = message;
        err.style.display = '';
        btn.disabled = false;
        btn.textContent = 'Try again';
        btn.style.display = '';
        // Only after a tapped retry: on the automatic first attempt, leave
        // focus alone so the role=alert message is read in full.
        if (retrying) btn.focus();
      }

      async function checkIn() {
        btn.disabled = true;
        btn.style.display = 'none';
        working.style.display = '';
        err.style.display = 'none';

        var res;
        var data = {};
        try {
          res = await fetch('/api/attendance/checkin', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ qr_token: token }),
            credentials: 'same-origin',
          });
          try {
            data = await res.json();
          } catch (e) {
            data = {};
          }
        } catch (e) {
          fail('Network hiccup — nothing was recorded. Try again.');
          return;
        }

        if (res.status === 201 || res.ok) {
          var doneAt = fmtTime(data && data.checked_in_at);
          if (doneAt) document.getElementById('done-time').textContent = doneAt;
          show(panelDone);
        } else if (res.status === 409) {
          // Already checked in — a calm, success-adjacent state, not an error.
          var alreadyAt = fmtTime(data && data.checked_in_at);
          if (alreadyAt) {
            document.getElementById('already-time').textContent = ' at ' + alreadyAt;
          }
          show(panelAlready);
        } else if (res.status === 401) {
          // Session evaporated between page load and the POST — restart sign-in.
          location.href = signinHref;
        } else if (data && data.reason === 'checkin_not_open' && fmtTime(data.opens_at)) {
          // This page's code will likely expire before then, so a retry here
          // can't work — send them back to the projected code instead.
          fail('Check-in opens at ' + fmtTime(data.opens_at) + '. Scan the code again then.');
          btn.style.display = 'none';
        } else {
          fail((data && data.error) || 'Something went wrong. Try again.');
        }
      }

      var retrying = false;
      btn.addEventListener('click', function () {
        retrying = true;
        checkIn();
      });
      // Scan → checked in. The owner chose automatic over a tap (2026-09-30).
      checkIn();
    </script>
  )}
</body>
</html>
